// ============================================================
// भाषा/فارسی.zy — फ़ारसी (fa)
// प्रतिज्ञातानि कार्याणि: शब्दः · अङ्गनाम · जयवाक्यम् · ग्रहणवाक्यम्
// सूत्राणि संस्कृतानि; आधारः भाषा/संस्कृतम्.zy इति सञ्चिकायाम्।
//
// एषा भाषा अन्यासु भिन्ना: दक्षिणतः वामं लिख्यते। पाठः तार्किके
// क्रमे एव संगृह्यते, पटलम् एव तं विपर्यस्य दर्शयति। स्तम्भानां
// गणना मानकम्/पटलम् एव करोति, अतः विस्तारः तत्रापि शुद्धः।
//
// फ़ारसी शतरञ्जस्य मातृभाषा। "शतरञ्ज" इति शब्दः एव "चतुरङ्ग"
// इत्यस्य फ़ारसी रूपम्, "शाह मात" इति च "मात" इत्यस्य मूलम्।
// क्रीडा एतेन एव मार्गेण भारतात् पश्चिमं गता।
//
// EN: भाषा/فارسی.zy — Persian locale (fa)
// Interface contract: शब्दः · अङ्गनाम · जयवाक्यम् · ग्रहणवाक्यम्
// The keys are Sanskrit; the base lives in भाषा/संस्कृतम्.zy.
//
// This locale is unlike the others: it is written right to left.
// The strings are stored in logical order and the terminal renders
// them reversed; column counts still come from मानकम्/पटलम्, so the
// panel measures correctly in Persian as in every other language.
//
// Persian is chess's mother tongue. شطرنج is the Persian form of
// चतुरङ्ग, and شاه مات — "the king is helpless" — is where the word
// "checkmate" comes from. This is the road the game took west.
// ============================================================

# .भाषा_فارسی {

    #> { शब्दः, अङ्गनाम, जयवाक्यम्, ग्रहणवाक्यम् }

    शब्दः(सूत्रम्) {
        <~ ?? सूत्रम् {
            "भाषा.नाम"                  => "فارسی"

            "सूची.शीर्षकम्"             => "شطرنج"
            "सूची.स्तरः"                => "سطح"
            "सूची.पक्षः"                => "رنگ شما"
            "सूची.रूपम्"                => "مهره‌ها"
            "सूची.फलकम्"                => "صفحه"
            "सूची.भाषा"                 => "زبان"
            "सूची.निर्देशः"             => "↑↓ انتخاب   ←→ تغییر   ↵ شروع"
            "सूची.अशक्यम्"              => "پایانه کوچک است"

            "स्तर.१"                    => "مبتدی"
            "स्तर.२"                    => "متوسط"
            "स्तर.३"                    => "پیشرفته"

            "रूप.शतरञ्जम्"              => "نشانه‌های شطرنج"
            "रूप.चित्रम्"               => "تصویری"
            "रूप.अक्षरम्"               => "دیوناگری"
            "रूप.लातिनम्"               => "لاتین"
            "फलक.अष्टापदम्"             => "اشتاپد"
            "फलक.चित्रितम्"             => "شطرنجی"

            "वर्ण.श्वेतः"               => "سفید"
            "वर्ण.कृष्णः"               => "سیاه"
            "पक्ष.मनुष्यः"              => "شما"
            "पक्ष.यन्त्रम्"             => "رایانه"

            "अङ्ग.पत्तिः"               => "پیاده"
            "अङ्ग.अश्वः"                => "اسب"
            "अङ्ग.गजः"                  => "فیل"
            "अङ्ग.रथः"                  => "رخ"
            "अङ्ग.मन्त्री"              => "فرزین"
            "अङ्ग.राजा"                 => "شاه"

            "खण्ड.हस्तः"                => "نوبت"
            "खण्ड.चालसंख्या"            => "حرکت‌ها"
            "खण्ड.गृहीतानि"             => "گرفته"
            "खण्ड.स्तरः"                => "سطح"
            "खण्ड.अन्तिमः"              => "آخرین"
            "खण्ड.सामग्री"              => "برتری"

            "वार्ता.अवैधः"              => "این حرکت مجاز نیست"
            "वार्ता.रिक्तम्"            => "آنجا مهره‌ای نیست"
            "वार्ता.परकीयम्"            => "آن مهرهٔ شما نیست"
            "वार्ता.स्वसंकटे"           => "شاه شما کیش می‌شود"
            "वार्ता.संकटे"              => "کیش!"
            "वार्ता.चिन्तयति"           => "در حال فکر کردن…"
            "वार्ता.प्रत्यावृत्तिः"     => "حرکت پس گرفته شد"
            "वार्ता.प्रत्यावृत्तिनास्ति" => "چیزی برای پس گرفتن نیست"
            "वार्ता.प्रवर्धनम्"         => "پیاده فرزین شد"
            "वार्ता.त्यागः"             => "تسلیم شد"

            "अन्तः.शीर्षकम्"            => "پایان بازی"
            "अन्तः.मातः"                => "مات"
            "अन्तः.गतिरोधः"             => "پات"
            "अन्तः.निर्वस्त्रः"         => "شاه برهنه"
            "अन्तः.समता"                => "مساوی"
            "अन्तः.पुनरावृत्तिः"        => "تکرار"
            "अन्तः.जयः"                 => "برد"

            "सञ्चालन.शीर्षकम्"          => "کلیدها"
            "सञ्चालन.गतिः"              => "حرکت نشانگر"
            "सञ्चालन.चयनम्"             => "انتخاب مهره · حرکت"
            "सञ्चालन.निरसनम्"           => "لغو انتخاب"
            "सञ्चालन.प्रत्यावृत्तिः"    => "پس گرفتن حرکت"
            "सञ्चालन.रूपान्तरम्"        => "تغییر مهره‌ها"
            "सञ्चालन.साहाय्यम्"         => "راهنما"
            "सञ्चालन.त्यागः"            => "تسلیم · خروج"

            "पटल.संकीर्णम्"             => "پایانه کوچک است"

            _                            => सूत्रम्
        }
    }

    अङ्गनाम(प्रकारः) {
        <~ ?? प्रकारः {
            १ => "پیاده"
            २ => "اسب"
            ३ => "فیل"
            ४ => "رخ"
            ५ => "فرزین"
            ६ => "شاه"
            _ => ""
        }
    }

    // فارسی कारणं "با" इत्यनेन योजयति। "شاه مات" इति द्वे पदे
    // एकः एव अर्थः, अतः मातस्य वाक्यं शेषेभ्यः भिन्नम्: तत्र
    // कारणं क्रियापदम् एव।
    //
    // EN: Persian builds the cause with با. "شاه مات" is two words
    // for one idea, so the mate sentence is shaped unlike the
    // others — there the cause is the verb itself.
    _कारणपदम्(कारणम्) {
        <~ ?? कारणम् {
            १ => "با مات"
            २ => "با پات"
            ३ => "با شاه برهنه"
            ५ => "با تسلیم حریف"
            _ => ""
        }
    }

    जयवाक्यम्(वर्णः, कारणम्) {
        ? कारणम् == ४ { <~ "مساوی" }
        ? कारणम् == ६ { <~ "مساوی با تکرار" }
        जेता = "سفید"
        ? वर्णः == २ { जेता = "سیاه" }
        पदम् = _कारणपदम्(कारणम्)
        ? पदम् == "" { <~ "{जेता} برد" }
        <~ "{जेता} {पदम्} برد"
    }

    ग्रहणवाक्यम्(प्रकारः) {
        नाम = अङ्गनाम(प्रकारः)
        ? नाम == "" { <~ "" }
        <~ "{नाम} گرفته شد"
    }
}
