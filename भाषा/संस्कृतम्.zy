// ============================================================
// भाषा/संस्कृतम्.zy — संस्कृतम् (sa)
// प्रतिज्ञातानि कार्याणि: शब्दः · अङ्गनाम · जयवाक्यम् · ग्रहणवाक्यम्
//
// एषा आधारभाषा। सूत्राणि संस्कृतानि, अयं च कोशः तानि संस्कृतवाक्येषु
// उद्घाटयति। अन्याः भाषाः एतस्य उपरि तिष्ठन्ति।
//
// EN: भाषा/संस्कृतम्.zy — Sanskrit locale (sa)
// Interface contract: शब्दः · अङ्गनाम · जयवाक्यम् · ग्रहणवाक्यम्
//
// This is the base language. The keys are Sanskrit and this table
// unfolds them into Sanskrit prose; every other locale sits on top
// of it.
// ============================================================

# .भाषा_संस्कृतम् {

    #> { शब्दः, अङ्गनाम, जयवाक्यम्, ग्रहणवाक्यम् }

    शब्दः(सूत्रम्) {
        <~ ?? सूत्रम् {
            "भाषा.नाम"                  => "संस्कृतम्"

            "सूची.शीर्षकम्"             => "चतुरङ्गम्"
            "सूची.स्तरः"                => "स्तरः"
            "सूची.पक्षः"                => "तव वर्णः"
            "सूची.रूपम्"                => "अङ्गरूपम्"
            "सूची.फलकम्"                => "फलकम्"
            "सूची.भाषा"                 => "भाषा"
            "सूची.निर्देशः"             => "↑↓ चयनम्   ←→ परिवर्तनम्   ↵ आरम्भः"
            "सूची.अशक्यम्"              => "पटलं संकीर्णम्"

            "स्तर.१"                    => "आरम्भकः"
            "स्तर.२"                    => "मध्यमः"
            "स्तर.३"                    => "निपुणः"

            "रूप.शतरञ्जम्"              => "शतरञ्जचिह्नानि"
            "रूप.चित्रम्"               => "चित्राणि"
            "रूप.अक्षरम्"               => "देवनागरी"
            "रूप.लातिनम्"               => "लातिनम्"
            "फलक.अष्टापदम्"             => "अष्टापदम्"
            "फलक.चित्रितम्"             => "चित्रितम्"

            "वर्ण.श्वेतः"               => "श्वेतः"
            "वर्ण.कृष्णः"               => "कृष्णः"
            "पक्ष.मनुष्यः"              => "त्वम्"
            "पक्ष.यन्त्रम्"             => "यन्त्रम्"

            "अङ्ग.पत्तिः"               => "पत्तिः"
            "अङ्ग.अश्वः"                => "अश्वः"
            "अङ्ग.गजः"                  => "गजः"
            "अङ्ग.रथः"                  => "रथः"
            "अङ्ग.मन्त्री"              => "मन्त्री"
            "अङ्ग.राजा"                 => "राजा"

            "खण्ड.हस्तः"                => "हस्तः"
            "खण्ड.चालसंख्या"            => "चालाः"
            "खण्ड.गृहीतानि"             => "गृहीतानि"
            "खण्ड.स्तरः"                => "स्तरः"
            "खण्ड.अन्तिमः"              => "अन्तिमः"
            "खण्ड.सामग्री"              => "सामग्री"

            "वार्ता.अवैधः"              => "अयं चालः न वैधः"
            "वार्ता.रिक्तम्"            => "तत्र किमपि नास्ति"
            "वार्ता.परकीयम्"            => "तत् तव अङ्गं न"
            "वार्ता.स्वसंकटे"           => "एतेन तव राजा संकटे पतेत्"
            "वार्ता.संकटे"              => "राजा संकटे!"
            "वार्ता.चिन्तयति"           => "चिन्तयति…"
            "वार्ता.प्रत्यावृत्तिः"     => "प्रत्यावृत्तम्"
            "वार्ता.प्रत्यावृत्तिनास्ति" => "प्रत्यावर्तयितुं किमपि नास्ति"
            "वार्ता.प्रवर्धनम्"         => "पत्तिः मन्त्री जातः"
            "वार्ता.त्यागः"             => "त्यक्तम्"

            "अन्तः.शीर्षकम्"            => "क्रीडायाः अन्तः"
            "अन्तः.मातः"                => "मातः"
            "अन्तः.गतिरोधः"             => "गतिरोधः"
            "अन्तः.निर्वस्त्रः"         => "निर्वस्त्रः राजा"
            "अन्तः.समता"                => "समता"
            "अन्तः.पुनरावृत्तिः"        => "पुनरावृत्तिः"
            "अन्तः.जयः"                 => "जयः"

            "सञ्चालन.शीर्षकम्"          => "सञ्चालनम्"
            "सञ्चालन.गतिः"              => "सूचकस्य गतिः"
            "सञ्चालन.चयनम्"             => "अङ्गचयनम् · चालः"
            "सञ्चालन.निरसनम्"           => "चयनस्य निरसनम्"
            "सञ्चालन.प्रत्यावृत्तिः"    => "प्रत्यावर्तनम्"
            "सञ्चालन.रूपान्तरम्"        => "रूपपरिवर्तनम्"
            "सञ्चालन.साहाय्यम्"         => "साहाय्यम्"
            "सञ्चालन.त्यागः"            => "त्यागः · निर्गमः"

            "पटल.संकीर्णम्"             => "पटलं संकीर्णम्"

            _                            => सूत्रम्
        }
    }

    अङ्गनाम(प्रकारः) {
        <~ ?? प्रकारः {
            १ => "पत्तिः"
            २ => "अश्वः"
            ३ => "गजः"
            ४ => "रथः"
            ५ => "मन्त्री"
            ६ => "राजा"
            _ => ""
        }
    }

    // संस्कृते कारणं तृतीयया विभक्त्या आगच्छति — "मातेन जयति",
    // न "मातः जयति"। एतत् एव कारणं यत् वाक्यानि सारण्यां न
    // स्थाप्यन्ते: सारणी विभक्तिं न जानाति।
    //
    // EN: In Sanskrit the cause arrives in the instrumental case —
    // "मातेन जयति", won *by means of* mate, not "mate wins". That
    // is exactly why these sentences are composed and not looked
    // up: a table does not decline.
    _कारणपदम्(कारणम्) {
        <~ ?? कारणम् {
            १ => "मातेन"
            २ => "गतिरोधेन"
            ३ => "निर्वस्त्रराज्ञा"
            ५ => "त्यागेन"
            _ => ""
        }
    }

    जयवाक्यम्(वर्णः, कारणम्) {
        ? कारणम् == ४ { <~ "समता" }
        ? कारणम् == ६ { <~ "पुनरावृत्त्या समता" }
        जेता = "श्वेतः"
        ? वर्णः == २ { जेता = "कृष्णः" }
        पदम् = _कारणपदम्(कारणम्)
        ? पदम् == "" { <~ "{जेता} जयति" }
        <~ "{जेता} {पदम्} जयति"
    }

    ग्रहणवाक्यम्(प्रकारः) {
        नाम = अङ्गनाम(प्रकारः)
        ? नाम == "" { <~ "" }
        <~ "{नाम} गृहीतः"
    }
}
