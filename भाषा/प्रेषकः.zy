// ============================================================
// भाषा/प्रेषकः.zy — शब्दानां प्रेषकः
//
// यत् किमपि क्रीडकः पश्यति, तत् सर्वम् अत्र एकेन एव द्वारेण गच्छति।
// वर्तमाना भाषा मॉड्यूलस्य स्थितिः — मॉड्यूलस्य स्थितिः पथानुसारं
// साझा भवति, अतः यः कोऽपि एतत् आनयति स एव चयनं पश्यति, विना
// भाषायाः प्राचलेन आह्वानश्रृङ्खलायाम्।
//
// सूत्राणि संस्कृतानि। आधारः संस्कृतम्, अन्याः भाषाः तस्य उपरि
// तिष्ठन्ति। यदा क्रीडा "खण्ड.गृहीतानि" इति याचते, तदा सा
// संस्कृतम् अर्थं याचते, न आङ्ग्लम् अभिज्ञानम्।
//
// अङ्काः अपि अनूद्यन्ते। एतत् GO इति क्रीडा न करोति, अत्र च
// आवश्यकम्: संस्कृतेन हिन्द्या च क्रीडा देवनागर्याम् अङ्कान्
// लिखति, फ़ारस्या पूर्वारब्येन, आङ्ग्ल्या स्पानिश्या च लातिनेन।
// एकः एव आदेशः — #०९# — सर्वं निर्गमं परिवर्तयति, संख्यानां
// सन्दर्भे, पाठे, संयोजने च। तस्य विस्तारः सम्पूर्णप्रक्रियायां,
// न एकस्मिन् एव सञ्चिकायाम्, यद्यपि GUIDE.md अन्यथा वदति।
//
// भाषां योजयितुं त्रीणि परिवर्तनानि: भाषा/<नाम>.zy इति सञ्चिका
// चतुर्णां कार्याणां प्रतिज्ञया, अत्र आनयनम्, प्रत्येकस्मिन्
// विभाजने एका शाखा। ततः परीक्षा/भाषापरीक्षा.zy सूत्रं सूत्रं
// परीक्षते।
//
// EN: भाषा/प्रेषकः.zy — the dispatcher of words
//
// Every string a player sees passes through this one door. The
// active locale is module state — module state is shared per file
// path, so everything that imports this sees the same choice
// without a language parameter threaded through the call graph.
//
// The keys are Sanskrit. Sanskrit is the base and every other
// language sits on top of it: asking for "खण्ड.गृहीतानि" asks for
// a concept, not for an English identifier.
//
// THE NUMERALS ARE TRANSLATED TOO. The go engine does not do this
// and here it is necessary: in Sanskrit and Hindi the game writes
// its numbers in Devanagari, in Persian in Eastern Arabic, in
// English and Spanish in Latin. One directive — #०९# — changes
// every numeric output there is: interpolation, juxtaposition,
// positioned output, all of it. Its reach is the whole process and
// not one file, whatever GUIDE.md says about it — measured in both
// engines.
//
// Adding a language is three edits: write भाषा/<name>.zy against
// the four-function contract, import it here, add one arm to each
// dispatch. परीक्षा/भाषापरीक्षा.zy then checks it key by key.
// ============================================================

# .भाषा_प्रेषकः {

    <# ./संस्कृतम् => सं
    <# ./हिन्दी => हि
    <# ./فارسی => फा
    <# ./English => आं
    <# ./Español => स्पा

    #> {
        निर्धारणम्
        वर्तमाना
        भाषासूची
        सूत्रसूची
        शब्दः
        अङ्गनाम
        जयवाक्यम्
        ग्रहणवाक्यम्
    }

    वर्तमानाभाषा = "sa"

    // ISO 639-1 इति संकेताः, सूच्याः क्रमेण। संकेताः स्वयम्
    // अन्तर्राष्ट्रीयाः, अतः न अनूद्यन्ते। संस्कृतम् अग्रे यतः
    // क्रीडा संस्कृतेन लिखिता; ततः हिन्दी यत्र अद्य क्रीड्यते,
    // ततः फ़ारसी येन मार्गेण क्रीडा पश्चिमं गता, ततः द्वे भाषे
    // याभ्यां क्रीडा लिखिता।
    //
    // EN: ISO 639-1 codes in menu order. The codes are an
    // international convention and stay as they are. Sanskrit leads
    // because the program is written in it; then Hindi, where the
    // game is played today; then Persian, the road it took west;
    // then the two languages this project documents itself in.
    भाषासूची() { <~ ["sa", "hi", "fa", "en", "es"] }

    वर्तमाना() { <~ वर्तमानाभाषा }

    // भाषया सह अङ्कलिपिः अपि निर्धार्यते। एतत् एव अस्य क्रीडायाः
    // विशेषः: "८" इति देवनागर्यां, "٨" इति फ़ारस्याम्, "8" इति
    // लातिनेन — एकस्य एव फलकस्य एकः एव पङ्क्त्यङ्कः।
    //
    // EN: Choosing a language chooses a digit script with it. That
    // is this game's own contribution: the same rank of the same
    // board is "८" in Devanagari, "٨" in Persian and "8" in Latin,
    // and no drawing code knows which.
    निर्धारणम्(संकेतः) {
        वर्तमानाभाषा = संकेतः
        // फ़ारसी विस्तृतान् पूर्वारब्यान् अङ्कान् (۰۹, U+06F0)
        // लिखति, न अरब्यान् (٠٩, U+0660)। द्वे लिप्यौ भिन्ने;
        // अरब्यान् अङ्कान् फ़ारस्यां लेखितुं शुद्धिदोषः।
        //
        // EN: Persian writes Extended Arabic-Indic digits (۰۹,
        // U+06F0), not the Arabic-Indic ones (٠٩, U+0660). They are
        // different scripts, and using the Arabic set for Persian is
        // an error a reader notices immediately.
        ?? संकेतः {
            "fa" => { #۰۹# }
            "en" => { #09# }
            "es" => { #09# }
            _    => { #०९# }
        }
        <~ ०
    }

    शब्दः(सूत्रम्) {
        ?? वर्तमानाभाषा {
            "hi" => { <~ हि::शब्दः(सूत्रम्) }
            "fa" => { <~ फा::शब्दः(सूत्रम्) }
            "en" => { <~ आं::शब्दः(सूत्रम्) }
            "es" => { <~ स्पा::शब्दः(सूत्रम्) }
            _    => { <~ सं::शब्दः(सूत्रम्) }
        }
    }

    अङ्गनाम(प्रकारः) {
        ?? वर्तमानाभाषा {
            "hi" => { <~ हि::अङ्गनाम(प्रकारः) }
            "fa" => { <~ फा::अङ्गनाम(प्रकारः) }
            "en" => { <~ आं::अङ्गनाम(प्रकारः) }
            "es" => { <~ स्पा::अङ्गनाम(प्रकारः) }
            _    => { <~ सं::अङ्गनाम(प्रकारः) }
        }
    }

    जयवाक्यम्(वर्णः, कारणम्) {
        ?? वर्तमानाभाषा {
            "hi" => { <~ हि::जयवाक्यम्(वर्णः, कारणम्) }
            "fa" => { <~ फा::जयवाक्यम्(वर्णः, कारणम्) }
            "en" => { <~ आं::जयवाक्यम्(वर्णः, कारणम्) }
            "es" => { <~ स्पा::जयवाक्यम्(वर्णः, कारणम्) }
            _    => { <~ सं::जयवाक्यम्(वर्णः, कारणम्) }
        }
    }

    ग्रहणवाक्यम्(प्रकारः) {
        ?? वर्तमानाभाषा {
            "hi" => { <~ हि::ग्रहणवाक्यम्(प्रकारः) }
            "fa" => { <~ फा::ग्रहणवाक्यम्(प्रकारः) }
            "en" => { <~ आं::ग्रहणवाक्यम्(प्रकारः) }
            "es" => { <~ स्पा::ग्रहणवाक्यम्(प्रकारः) }
            _    => { <~ सं::ग्रहणवाक्यम्(प्रकारः) }
        }
    }

    // सूत्राणां मूलसूची। एषा एव प्रतिज्ञा यां प्रत्येकया भाषया
    // पूरणीया, परीक्षा/भाषापरीक्षा.zy च एतां सर्वासु भाषासु
    // चालयति, संस्कृते अपि, यत् सूत्रं तथैव प्रत्यागच्छति तत्
    // सूचयति च।
    //
    // प्रत्येकं सूत्रं क्षेत्रोपसर्गं धारयति ("अन्तः.मातः", न
    // केवलं "मातः")। कारणम्: सूत्रं स्वस्य एव संस्कृतानुवादेन
    // समानं न भवेत्। तेन एव "अनुवादः सूत्रेण समः = अभावः" इति
    // परीक्षा संस्कृते अपि साधुः भवति।
    //
    // EN: The master key catalogue — the contract every locale must
    // satisfy. परीक्षा/भाषापरीक्षा.zy walks it against every locale,
    // Sanskrit included, and reports any key that falls through to
    // the identity case.
    //
    // Every key carries a domain prefix ("अन्तः.मातः", never plain
    // "मातः") so that a key can never equal its own Sanskrit
    // translation. That is what keeps "translation equals key means
    // missing" decidable in the base language too.
    सूत्रसूची() {
        <~ [
            "भाषा.नाम",

            "सूची.शीर्षकम्", "सूची.स्तरः", "सूची.पक्षः",
            "सूची.रूपम्", "सूची.फलकम्", "सूची.भाषा",
            "सूची.निर्देशः", "सूची.अशक्यम्",

            "स्तर.१", "स्तर.२", "स्तर.३",

            "रूप.शतरञ्जम्", "रूप.चित्रम्", "रूप.अक्षरम्", "रूप.लातिनम्",
            "फलक.अष्टापदम्", "फलक.चित्रितम्",

            "वर्ण.श्वेतः", "वर्ण.कृष्णः",
            "पक्ष.मनुष्यः", "पक्ष.यन्त्रम्",

            "अङ्ग.पत्तिः", "अङ्ग.अश्वः", "अङ्ग.गजः",
            "अङ्ग.रथः", "अङ्ग.मन्त्री", "अङ्ग.राजा",

            "खण्ड.हस्तः", "खण्ड.चालसंख्या", "खण्ड.गृहीतानि",
            "खण्ड.स्तरः", "खण्ड.अन्तिमः", "खण्ड.सामग्री",

            "वार्ता.अवैधः", "वार्ता.रिक्तम्", "वार्ता.परकीयम्",
            "वार्ता.स्वसंकटे", "वार्ता.संकटे", "वार्ता.चिन्तयति",
            "वार्ता.प्रत्यावृत्तिः", "वार्ता.प्रत्यावृत्तिनास्ति",
            "वार्ता.प्रवर्धनम्", "वार्ता.त्यागः",

            "अन्तः.शीर्षकम्", "अन्तः.मातः", "अन्तः.गतिरोधः",
            "अन्तः.निर्वस्त्रः", "अन्तः.समता", "अन्तः.पुनरावृत्तिः",
            "अन्तः.जयः",

            "सञ्चालन.शीर्षकम्", "सञ्चालन.गतिः", "सञ्चालन.चयनम्",
            "सञ्चालन.निरसनम्", "सञ्चालन.प्रत्यावृत्तिः",
            "सञ्चालन.रूपान्तरम्", "सञ्चालन.साहाय्यम्",
            "सञ्चालन.त्यागः",

            "पटल.संकीर्णम्"
        ]
    }
}
