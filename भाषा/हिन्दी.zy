// ============================================================
// भाषा/हिन्दी.zy — हिन्दी (hi)
// प्रतिज्ञातानि कार्याणि: शब्दः · अङ्गनाम · जयवाक्यम् · ग्रहणवाक्यम्
// सूत्राणि संस्कृतानि; आधारः भाषा/संस्कृतम्.zy इति सञ्चिकायाम्।
//
// EN: भाषा/हिन्दी.zy — Hindi locale (hi)
// Interface contract: शब्दः · अङ्गनाम · जयवाक्यम् · ग्रहणवाक्यम्
// The keys are Sanskrit; the base lives in भाषा/संस्कृतम्.zy.
//
// Hindi shares the script and much of the vocabulary with the base
// language, which makes it the locale most likely to hide a missing
// key behind a word that looks right. The completeness gate does
// not read words, only whether a key came back unchanged.
// ============================================================

# .भाषा_हिन्दी {

    #> { शब्दः, अङ्गनाम, जयवाक्यम्, ग्रहणवाक्यम् }

    शब्दः(सूत्रम्) {
        <~ ?? सूत्रम् {
            "भाषा.नाम"                  => "हिन्दी"

            "सूची.शीर्षकम्"             => "चतुरंग"
            "सूची.स्तरः"                => "स्तर"
            "सूची.पक्षः"                => "आपका रंग"
            "सूची.रूपम्"                => "मोहरे"
            "सूची.फलकम्"                => "बिसात"
            "सूची.भाषा"                 => "भाषा"
            "सूची.निर्देशः"             => "↑↓ चुनें   ←→ बदलें   ↵ शुरू"
            "सूची.अशक्यम्"              => "टर्मिनल छोटा है"

            "स्तर.१"                    => "शुरुआती"
            "स्तर.२"                    => "मध्यम"
            "स्तर.३"                    => "कुशल"

            "रूप.शतरञ्जम्"              => "शतरंज चिह्न"
            "रूप.चित्रम्"               => "चित्र"
            "रूप.अक्षरम्"               => "देवनागरी"
            "रूप.लातिनम्"               => "रोमन"
            "फलक.अष्टापदम्"             => "अष्टापद"
            "फलक.चित्रितम्"             => "चौकोर"

            "वर्ण.श्वेतः"               => "सफ़ेद"
            "वर्ण.कृष्णः"               => "काला"
            "पक्ष.मनुष्यः"              => "आप"
            "पक्ष.यन्त्रम्"             => "कंप्यूटर"

            "अङ्ग.पत्तिः"               => "प्यादा"
            "अङ्ग.अश्वः"                => "घोड़ा"
            "अङ्ग.गजः"                  => "हाथी"
            "अङ्ग.रथः"                  => "रथ"
            "अङ्ग.मन्त्री"              => "मंत्री"
            "अङ्ग.राजा"                 => "राजा"

            "खण्ड.हस्तः"                => "चाल"
            "खण्ड.चालसंख्या"            => "चालें"
            "खण्ड.गृहीतानि"             => "पिटे"
            "खण्ड.स्तरः"                => "स्तर"
            "खण्ड.अन्तिमः"              => "पिछली"
            "खण्ड.सामग्री"              => "बढ़त"

            "वार्ता.अवैधः"              => "यह चाल नहीं चल सकती"
            "वार्ता.रिक्तम्"            => "वहाँ कोई मोहरा नहीं है"
            "वार्ता.परकीयम्"            => "वह आपका मोहरा नहीं है"
            "वार्ता.स्वसंकटे"           => "इससे आपका राजा शह में आ जाएगा"
            "वार्ता.संकटे"              => "शह!"
            "वार्ता.चिन्तयति"           => "सोच रहा है…"
            "वार्ता.प्रत्यावृत्तिः"     => "चाल वापस ली"
            "वार्ता.प्रत्यावृत्तिनास्ति" => "वापस लेने को कुछ नहीं"
            "वार्ता.प्रवर्धनम्"         => "प्यादा मंत्री बन गया"
            "वार्ता.त्यागः"             => "हार मानी"

            "अन्तः.शीर्षकम्"            => "खेल समाप्त"
            "अन्तः.मातः"                => "मात"
            "अन्तः.गतिरोधः"             => "गतिरोध"
            "अन्तः.निर्वस्त्रः"         => "अकेला राजा"
            "अन्तः.समता"                => "बराबरी"
            "अन्तः.पुनरावृत्तिः"        => "पुनरावृत्ति"
            "अन्तः.जयः"                 => "जीत"

            "सञ्चालन.शीर्षकम्"          => "कुंजियाँ"
            "सञ्चालन.गतिः"              => "कर्सर चलाएँ"
            "सञ्चालन.चयनम्"             => "मोहरा चुनें · चाल चलें"
            "सञ्चालन.निरसनम्"           => "चयन रद्द करें"
            "सञ्चालन.प्रत्यावृत्तिः"    => "चाल वापस लें"
            "सञ्चालन.रूपान्तरम्"        => "मोहरे बदलें"
            "सञ्चालन.साहाय्यम्"         => "मदद"
            "सञ्चालन.त्यागः"            => "हार मानें · बाहर"

            "पटल.संकीर्णम्"             => "टर्मिनल छोटा है"

            _                            => सूत्रम्
        }
    }

    अङ्गनाम(प्रकारः) {
        <~ ?? प्रकारः {
            १ => "प्यादा"
            २ => "घोड़ा"
            ३ => "हाथी"
            ४ => "रथ"
            ५ => "मंत्री"
            ६ => "राजा"
            _ => ""
        }
    }

    // हिन्दी में कारण "से" के साथ आता है, और जीतने वाले का लिंग
    // वाक्य बदल देता है — "सफ़ेद जीता", "काला जीता"। दोनों पुल्लिंग
    // हैं, तो यहाँ वह भेद नहीं दिखता; पर रंग स्त्रीलिंग होते तो
    // तालिका काम न आती।
    //
    // EN: Hindi builds the cause with से. Both colour words happen
    // to be masculine, so the agreement is invisible here — but a
    // lookup table would have had no way to produce it if they
    // were not.
    _कारणपदम्(कारणम्) {
        <~ ?? कारणम् {
            १ => "मात से"
            २ => "गतिरोध से"
            ३ => "अकेले राजा से"
            ५ => "हार मानने से"
            _ => ""
        }
    }

    जयवाक्यम्(वर्णः, कारणम्) {
        ? कारणम् == ४ { <~ "बराबरी" }
        ? कारणम् == ६ { <~ "पुनरावृत्ति से बराबरी" }
        जेता = "सफ़ेद"
        ? वर्णः == २ { जेता = "काला" }
        पदम् = _कारणपदम्(कारणम्)
        ? पदम् == "" { <~ "{जेता} जीता" }
        <~ "{जेता} {पदम्} जीता"
    }

    ग्रहणवाक्यम्(प्रकारः) {
        नाम = अङ्गनाम(प्रकारः)
        ? नाम == "" { <~ "" }
        <~ "{नाम} पिट गया"
    }
}
