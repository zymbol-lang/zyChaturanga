// ============================================================
// परीक्षा/चित्रपरीक्षा.zy — द्विस्तम्भस्य नियमस्य परीक्षा
//
//   zymbol run परीक्षा/चित्रपरीक्षा.zy
//
// एका एव प्रतिज्ञा, चतुर्षु रूपेषु परीक्षिता: फलकस्य प्रत्येका
// पङ्क्तिः ठीकं षोडश स्तम्भान् गृह्णाति, तस्यां यत् किमपि अस्तु।
//
// प्रथमे च अन्तिमे स्तम्भे अङ्गानि विशेषेण स्थाप्यन्ते। तत्रैव
// GO इति क्रीडायाः दोषः प्रायः आसीत्: अन्तिमे स्तम्भे चिह्नस्य
// विस्तारः भिन्नः चेत् पङ्क्तेः अङ्कः चलति, और तत् केवलं तदा
// दृश्यते यदा तत्र अङ्गं स्थाप्यते।
//
// पटलं न अपेक्ष्यते। पङ्क्तिपाठः() वर्णरहितं पाठं ददाति, अतः
// एषा परीक्षा नलिकायाम् अपि चलति — यत् >>| न शक्नोति।
//
// EN: परीक्षा/चित्रपरीक्षा.zy — the two-column invariant
//
//   zymbol run परीक्षा/चित्रपरीक्षा.zy
//
// One promise, checked in four themes: every board row occupies
// exactly sixteen columns, whatever stands on it.
//
// Pieces are placed in the first and last files on purpose. That is
// where the go engine's bug lived: if the glyph in the last file
// has a different width, the row label shifts — and it only shows
// once a piece is actually played there.
//
// No terminal needed. पङ्क्तिपाठः() returns colourless text, so this
// suite runs down a pipe, which >>| cannot.
// ============================================================

<# ../मूल/अष्टापदम् => अ
<# ../दर्शनम्/चित्रणम् => चि
<# ../दर्शनम्/रूपम् => रू
<# ../दर्शनम्/अक्षरम् => अक्ष
<# ../भाषा/प्रेषकः => भा
<# ./आकृतिः => आ

निवेदनम्(नाम, वास्तवम्, अपेक्षितम्, दोषाः<~) {
    ? वास्तवम् == अपेक्षितम् {
        >> "  ok    " नाम ¶
    } _ {
        >> "  FAIL  " नाम "   expected " अपेक्षितम् ", got " वास्तवम् ¶
        दोषाः = दोषाः + 1
    }
}

दोषाः = 0
>> "चतुरङ्गम् — layout arithmetic" ¶
>> "" ¶

// ---- सर्वेषु रूपेषु प्रत्येका पङ्क्तिः षोडशस्तम्भा ------------
// EN: every row is 16 columns in every theme
>> "पङ्क्तिविस्तारः — every row is 16 columns" ¶

आदिस्थितिः = अ::नवम्()
अ::सेनास्थापनम्(आदिस्थितिः<~)

@ रूपम् : रू::रूपसूची() {
    दोषः = 0
    @ पङ्क्तिः:1..8 {
        व = अक्ष::विस्तारः(चि::पङ्क्तिपाठः(आदिस्थितिः, रूपम्, पङ्क्तिः))
        ? व <> 16 { दोषः = दोषः + 1 }
    }
    निवेदनम्("[" $++ रूपम् $++ "] opening position", दोषः, 0, दोषाः<~)
}

// ---- प्रथमे अन्तिमे च स्तम्भे अङ्गानि --------------------------
// EN: pieces in the first and last files — where it actually breaks
>> "" ¶
>> "अन्तस्तम्भाः — pieces in the first and last files" ¶

कोणस्थितिः = आ::पठनम्([
    "K......k",
    "P......p",
    "R......r",
    "N......n",
    "B......b",
    "Q......q",
    "........",
    "K......k"
])

@ रूपम् : रू::रूपसूची() {
    दोषः = 0
    @ पङ्क्तिः:1..8 {
        व = अक्ष::विस्तारः(चि::पङ्क्तिपाठः(कोणस्थितिः, रूपम्, पङ्क्तिः))
        ? व <> 16 { दोषः = दोषः + 1 }
    }
    निवेदनम्("[" $++ रूपम् $++ "] every piece on both edges", दोषः, 0, दोषाः<~)
}

// ---- रिक्तं फलकम् --------------------------------------------
// EN: an empty board must measure the same as a full one
>> "" ¶
>> "रिक्तम् — an empty board measures the same" ¶
रिक्तस्थितिः = अ::नवम्()
@ रूपम् : रू::रूपसूची() {
    दोषः = 0
    @ पङ्क्तिः:1..8 {
        व = अक्ष::विस्तारः(चि::पङ्क्तिपाठः(रिक्तस्थितिः, रूपम्, पङ्क्तिः))
        ? व <> 16 { दोषः = दोषः + 1 }
    }
    निवेदनम्("[" $++ रूपम् $++ "] empty board", दोषः, 0, दोषाः<~)
}

// ---- अक्षराणाम् मानम् ----------------------------------------
// EN: the measurements the invariant rests on. "रा" is two
// graphemes and two columns; "र" is one of each; an emoji is one
// grapheme and two columns. If any of these ever changed, the rows
// above would still pass and the board would still be wrong.
>> "" ¶
>> "अक्षरमानम् — the widths the invariant rests on" ¶
निवेदनम्("र is 1 column", अक्ष::विस्तारः("र"), 1, दोषाः<~)
निवेदनम्("रा is 2 columns", अक्ष::विस्तारः("रा"), 2, दोषाः<~)
निवेदनम्("रा is 2 graphemes", "रा"$#, 2, दोषाः<~)
निवेदनम्("🐘 is 2 columns", अक्ष::विस्तारः("🐘"), 2, दोषाः<~)
निवेदनम्("🐘 is 1 grapheme", "🐘"$#, 1, दोषाः<~)
निवेदनम्("♔ is 1 column", अक्ष::विस्तारः("♔"), 1, दोषाः<~)

// एतत् एव कारणं यत् GO इति क्रीडा ● ○ इति चिह्ने त्यक्तवती:
// तयोः विस्तारः पटलस्य विन्यासेन बध्यते।
// EN: this is why the go engine refused ● and ○ — East Asian
// Ambiguous, one column in a Western terminal and two in a
// CJK-configured one.
निवेदनम्("कोष्ठपूरणम् pads 1 to 2", अक्ष::विस्तारः(अक्ष::कोष्ठपूरणम्("र", " ")), 2, दोषाः<~)
निवेदनम्("कोष्ठपूरणम् leaves 2 alone", अक्ष::विस्तारः(अक्ष::कोष्ठपूरणम्("रा", " ")), 2, दोषाः<~)
निवेदनम्("कोष्ठपूरणम् fills an empty cell", अक्ष::विस्तारः(अक्ष::कोष्ठपूरणम्("", " ")), 2, दोषाः<~)

// ---- विन्यासः ------------------------------------------------
// EN: layout selection from a terminal size
>> "" ¶
>> "विन्यासः — layout selection" ¶
निवेदनम्("80×24 is side by side", रू::विन्यासः(80, 24), 2, दोषाः<~)
निवेदनम्("40×24 is stacked", रू::विन्यासः(40, 24), 1, दोषाः<~)
निवेदनम्("20×24 is impossible", रू::विन्यासः(20, 24), 0, दोषाः<~)
निवेदनम्("80×10 is impossible", रू::विन्यासः(80, 10), 0, दोषाः<~)
निवेदनम्("49×13 is exactly side by side", रू::विन्यासः(49, 13), 2, दोषाः<~)
निवेदनम्("48×13 falls back", रू::विन्यासः(48, 13), 0, दोषाः<~)
निवेदनम्("48×15 falls back to stacked", रू::विन्यासः(48, 15), 1, दोषाः<~)

// ---- पदावली ---------------------------------------------------
// EN: square names — the file is a Latin letter everywhere, the
// rank follows the locale's numeral script. Same code, three sets
// of glyphs.
>> "" ¶
>> "पदावली — square names follow the numeral script" ¶
कोणपदम् = अ::पदम्(4, 5)
भा::निर्धारणम्("sa")
निवेदनम्("Sanskrit e4", चि::पदनाम(कोणपदम्), "e४", दोषाः<~)
भा::निर्धारणम्("fa")
निवेदनम्("Persian e4", चि::पदनाम(कोणपदम्), "e۴", दोषाः<~)
भा::निर्धारणम्("en")
निवेदनम्("English e4", चि::पदनाम(कोणपदम्), "e4", दोषाः<~)
निवेदनम्("a1 is the first square", चि::पदनाम(1), "a1", दोषाः<~)
निवेदनम्("h8 is the last square", चि::पदनाम(64), "h8", दोषाः<~)

>> "" ¶
? दोषाः == 0 {
    >> "PASS — the grid holds together" ¶
} _ {
    >> "FAIL — " दोषाः " problem(s)" ¶
}
