// ============================================================
// परीक्षा/भाषापरीक्षा.zy — भाषाणां पूर्णतायाः द्वारपालः
//
//   zymbol run परीक्षा/भाषापरीक्षा.zy
//
// प्रत्येकं सूत्रं प्रत्येकस्यां भाषायां पृच्छ्यते। सूत्रम् एव
// प्रत्यागच्छति चेत् अनुवादः नास्ति — तच्च दृश्यम्, यतः प्रत्येकं
// सूत्रं क्षेत्रोपसर्गं धारयति और स्वस्य एव अनुवादेन समं न भवति।
// अतः एषा परीक्षा संस्कृते अपि साधुः, यत् आधारभाषायाम् अपि
// विस्मृतं सूत्रं गोपयितुं न शक्यते।
//
// संयोजितानि वाक्यानि अपि परीक्ष्यन्ते। सारणी "मातेन जयति" इति
// न वक्तुं शक्नोति; तत् विभक्तिः, सा च कार्यस्य कर्म।
//
// EN: परीक्षा/भाषापरीक्षा.zy — the i18n completeness gate
//
//   zymbol run परीक्षा/भाषापरीक्षा.zy
//
// Every key is asked of every locale. A key that comes back
// unchanged has no translation — and that is visible, because
// every key carries a domain prefix and so can never equal its own
// translation. That is what makes the check sound in Sanskrit too:
// the base language cannot hide a forgotten key either.
//
// The composed sentences are checked as well. A table cannot say
// "wins by checkmate" in five grammars — that is declension, and
// declension is a function's job.
// ============================================================

<# ../भाषा/प्रेषकः => भा

निवेदनम्(नाम, वास्तवम्, अपेक्षितम्, दोषाः<~) {
    ? वास्तवम् == अपेक्षितम् {
        >> "  ok    " नाम ¶
    } _ {
        >> "  FAIL  " नाम "   expected " अपेक्षितम् ", got " वास्तवम् ¶
        दोषाः = दोषाः + 1
    }
}

दोषाः = 0
>> "चतुरङ्गम् — i18n completeness" ¶
>> "" ¶

सूत्राणि = भा::सूत्रसूची()
कुलसूत्राणि = सूत्राणि$#

// ---- प्रत्येकं सूत्रं प्रत्येकस्यां भाषायाम् ----------------
// EN: every key in every locale
@ संकेतः : भा::भाषासूची() {
    भा::निर्धारणम्(संकेतः)
    नाम = भा::शब्दः("भाषा.नाम")
    अभावाः = ""
    गणना = 0
    @ सूत्रम् : सूत्राणि {
        अनुवादः = भा::शब्दः(सूत्रम्)
        ? अनुवादः == सूत्रम् {
            अभावाः = अभावाः $++ " " सूत्रम्
        } _ {
            गणना = गणना + 1
        }
    }
    ? अभावाः == "" {
        >> "  ok    [" संकेतः "] " नाम "   " गणना "/" कुलसूत्राणि ¶
    } _ {
        >> "  FAIL  [" संकेतः "] " नाम "   " गणना "/" कुलसूत्राणि "  missing:" अभावाः ¶
        दोषाः = दोषाः + 1
    }
}

// ---- अङ्गानां नामानि ----------------------------------------
// EN: piece names — six kinds, five languages, none empty
>> "" ¶
>> "अङ्गनाम — piece names" ¶
@ संकेतः : भा::भाषासूची() {
    भा::निर्धारणम्(संकेतः)
    रिक्ताः = 0
    @ प्रकारः:1..6 {
        ? भा::अङ्गनाम(प्रकारः) == "" { रिक्ताः = रिक्ताः + 1 }
    }
    निवेदनम्("[" $++ संकेतः $++ "] six pieces named", रिक्ताः, 0, दोषाः<~)
}

// ---- संयोजितानि वाक्यानि -------------------------------------
// EN: the composed sentences. Not compared against fixed strings —
// this asserts they are composed at all: non-empty, different for
// the two colours, and different for two different causes.
>> "" ¶
>> "जयवाक्यम् — composed result sentences" ¶
@ संकेतः : भा::भाषासूची() {
    भा::निर्धारणम्(संकेतः)
    श्वेतमातः = भा::जयवाक्यम्(1, 1)
    कृष्णमातः = भा::जयवाक्यम्(2, 1)
    श्वेतत्यागः = भा::जयवाक्यम्(1, 5)
    समता = भा::जयवाक्यम्(1, 4)

    दोषः = 0
    ? श्वेतमातः == "" { दोषः = दोषः + 1 }
    ? श्वेतमातः == कृष्णमातः { दोषः = दोषः + 1 }
    ? श्वेतमातः == श्वेतत्यागः { दोषः = दोषः + 1 }
    ? समता == "" { दोषः = दोषः + 1 }
    ? समता == श्वेतमातः { दोषः = दोषः + 1 }
    निवेदनम्("[" $++ संकेतः $++ "] four distinct sentences", दोषः, 0, दोषाः<~)
}

>> "" ¶
>> "ग्रहणवाक्यम् — composed capture sentences" ¶
@ संकेतः : भा::भाषासूची() {
    भा::निर्धारणम्(संकेतः)
    दोषः = 0
    ? भा::ग्रहणवाक्यम्(3) == "" { दोषः = दोषः + 1 }
    ? भा::ग्रहणवाक्यम्(3) == भा::ग्रहणवाक्यम्(4) { दोषः = दोषः + 1 }
    निवेदनम्("[" $++ संकेतः $++ "] elephant and chariot differ", दोषः, 0, दोषाः<~)
}

// ---- अङ्कलिप्यः ----------------------------------------------
// EN: the digit scripts. This is what this game adds to the go
// engine's i18n: choosing a language chooses a numeral script, and
// the same number comes out in three different sets of glyphs.
>> "" ¶
>> "अङ्कलिपिः — numeral scripts" ¶
// एका एव संख्या, पञ्चसु भाषासु। सन्दर्भः {नाम} इति एव गृह्णाति,
// न {२०२६} इति, अतः संख्या पूर्वं नाम्नि बध्यते।
// EN: One number, five languages. Interpolation takes {identifier}
// only, so the number is bound to a name first.
वर्षम् = 2026

भा::निर्धारणम्("sa")
देवनागरी = "{वर्षम्}"
भा::निर्धारणम्("fa")
फ़ारसी = "{वर्षम्}"
भा::निर्धारणम्("en")
लातिनम् = "{वर्षम्}"
भा::निर्धारणम्("hi")
हिन्दी = "{वर्षम्}"
भा::निर्धारणम्("es")
स्पानिश् = "{वर्षम्}"

निवेदनम्("Devanagari digits", देवनागरी, "२०२६", दोषाः<~)
निवेदनम्("Persian digits", फ़ारसी, "۲۰۲۶", दोषाः<~)
निवेदनम्("Latin digits", लातिनम्, "2026", दोषाः<~)
निवेदनम्("Hindi shares Devanagari", हिन्दी, "२०२६", दोषाः<~)
निवेदनम्("Spanish shares Latin", स्पानिश्, "2026", दोषाः<~)

// अङ्कलिपिः पुनः लातिना क्रियते, यथा अन्तिमं निवेदनम् पठनीयम्।
// EN: back to Latin so the verdict line reads the same in a diff.
भा::निर्धारणम्("en")

>> "" ¶
? दोषाः == 0 {
    >> "PASS — every key resolves in every locale" ¶
} _ {
    >> "FAIL — " दोषाः " problem(s)" ¶
}
