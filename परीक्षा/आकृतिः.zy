// ============================================================
// परीक्षा/आकृतिः.zy — परीक्षार्थम् अक्षरैः लिखिता स्थितिः
//
// नियमानां परीक्षा तदैव पुनर्दृश्या यदा स्थितिः पठनीया। अतः
// परीक्षास्थितयः आकृतिरूपेण लिख्यन्ते, अत्र च पठ्यन्ते।
//
// अक्षराणि अन्तर्राष्ट्रीयानि — R N B Q K P — न देवनागरीयाणि,
// एकेन कारणेन: देवनागर्यां वर्णभेदः (उच्च-नीच) नास्ति, अतः
// श्वेतं कृष्णं च एकाक्षरेण भेत्तुं न शक्यते। तानि च अक्षराणि
// एतेषाम् एव अङ्गानां वंशजानि — रथः → rook, अश्वः → knight,
// गजः → alfil → bishop, मन्त्री → ferz → queen, राजा → shah →
// king। अतः उधारं न, प्रत्यागमनम्।
//
// आकृतेः प्रथमा पङ्क्तिः अष्टमी पङ्क्तिः — कृष्णस्य गृहम्।
// एवं सर्वे शतरञ्जक्रीडकाः स्थितिं लिखन्ति।
//
// EN: परीक्षा/आकृतिः.zy — positions written as text, for tests
//
// A rule test is only reviewable if the position is readable, so
// test positions are written as diagrams and parsed here.
//
// The letters are the international ones — R N B Q K P — and not
// Devanagari, for one reason: Devanagari has no letter case, so a
// single character cannot distinguish white from black. And those
// letters descend from these very pieces: रथः → rook, अश्वः →
// knight, गजः → alfil → bishop, मन्त्री → ferz → queen, राजा →
// shah → king. Borrowing them back is a homecoming, not a loan.
//
// The first line of a diagram is rank 8 — black's home — which is
// how every chess player writes a position down.
// ============================================================

// @zyq-skip: a helper module for the test suites, not a suite; it parses the
// @zyq-skip: board diagrams the rule tests are written as, and running it
// @zyq-skip: directly proves nothing.
# .परीक्षा_आकृतिः {

    <# ../मूल/अष्टापदम् => अ

    #> { पठनम्, लेखनम्, पदपाठः, पदनाम, चालनाम }

    _अक्षराङ्गम्(अक्षरम्) {
        <~ ?? अक्षरम् {
            'P' => १
            'N' => २
            'B' => ३
            'R' => ४
            'Q' => ५
            'K' => ६
            'p' => ७
            'n' => ८
            'b' => ९
            'r' => १०
            'q' => ११
            'k' => १२
            _   => ०
        }
    }

    _अङ्गाक्षरम्(अङ्गम्) {
        <~ ?? अङ्गम् {
            १  => "P"
            २  => "N"
            ३  => "B"
            ४  => "R"
            ५  => "Q"
            ६  => "K"
            ७  => "p"
            ८  => "n"
            ९  => "b"
            १० => "r"
            ११ => "q"
            १२ => "k"
            _  => "."
        }
    }

    // आकृतेः प्रथमा पङ्क्तिः अष्टमी, अतः विपर्ययः।
    // EN: The diagram's first line is rank 8, so the rows are
    // filled from the top down.
    पठनम्(पङ्क्तयः) {
        स्थितिः = अ::नवम्()
        संख्या = पङ्क्तयः$#
        @ अनुक्रमः:१..संख्या {
            पङ्क्तिः = ८ - अनुक्रमः + १
            स्तम्भः = १
            @ अक्षरम् : पङ्क्तयः[अनुक्रमः] {
                ? स्तम्भः <= ८ {
                    अ::स्थापनम्(स्थितिः, पङ्क्तिः, स्तम्भः, _अक्षराङ्गम्(अक्षरम्))
                }
                स्तम्भः = स्तम्भः + १
            }
        }
        <~ स्थितिः
    }

    लेखनम्(स्थितिः) {
        फलम् = ""
        @ अनुक्रमः:१..८ {
            पङ्क्तिः = ८ - अनुक्रमः + १
            रेखा = ""
            @ स्तम्भः:१..८ {
                अक्षरम् = _अङ्गाक्षरम्(अ::ग्रहणम्(स्थितिः, पङ्क्तिः, स्तम्भः))
                रेखा = "{रेखा}{अक्षरम्}"
            }
            फलम् = "{फलम्}{रेखा}
"
        }
        <~ फलम्
    }

    // "e4" इति पदस्य अङ्कः। परीक्षा एव एतत् उपयुङ्क्ते; क्रीडा
    // स्वस्याः भाषायाः पदावलीं दर्शनम्/ इति स्तरात् प्राप्नोति।
    //
    // EN: The index of a square written "e4". Only the tests use
    // this; the game gets its own locale's notation from दर्शनम्/.
    पदपाठः(पाठः) {
        स्तम्भाक्षरम् = पाठः$[१..१]
        पङ्क्त्यक्षरम् = पाठः$[२..२]
        स्तम्भः = ?? स्तम्भाक्षरम् {
            "a" => १
            "b" => २
            "c" => ३
            "d" => ४
            "e" => ५
            "f" => ६
            "g" => ७
            "h" => ८
            _   => ०
        }
        ? स्तम्भः == ० { <~ ० }
        <~ अ::पदम्(#|पङ्क्त्यक्षरम्|, स्तम्भः)
    }

    पदनाम(स्थानम्) {
        अक्षराणि = "abcdefgh"
        स्तम्भः = अ::स्तम्भाङ्कः(स्थानम्)
        अक्षरम् = अक्षराणि$[स्तम्भः..स्तम्भः]
        पङ्क्तिः = अ::पङ्क्त्यङ्कः(स्थानम्)
        <~ "{अक्षरम्}{पङ्क्तिः}"
    }

    चालनाम(चालः) {
        आदिः = पदनाम(अ::आदिपदम्(चालः))
        अन्तः = पदनाम(अ::अन्तपदम्(चालः))
        <~ "{आदिः}{अन्तः}"
    }
}
