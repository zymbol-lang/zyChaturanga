// ============================================================
// परीक्षा/नियमपरीक्षा.zy — नियमानां परीक्षा
//
//   zymbol run परीक्षा/नियमपरीक्षा.zy
//
// प्रत्येका स्थितिः आकृतिरूपेण लिखिता, अतः अपेक्षितं फलं फलकेन
// सह दृष्ट्वा एव परीक्षितुं शक्यते। आकृतेः प्रथमा पङ्क्तिः अष्टमी।
//
// अत्र त्रयः प्रश्नाः पृच्छ्यन्ते, ते च भिन्नाः:
//   १. अङ्गं कुत्र गन्तुं शक्नोति — गतिनियमः
//   २. कः चालः वैधः — राज्ञः नियमः
//   ३. क्रीडा कदा समाप्ता — अन्तस्य नियमः
//
// EN: परीक्षा/नियमपरीक्षा.zy — the rule engine
//
//   zymbol run परीक्षा/नियमपरीक्षा.zy
//
// Every position is written as a diagram so the expected answer can
// be checked by eye against the board. The diagram's first line is
// rank 8.
//
// Three different questions are asked here:
//   1. where a piece can go — the movement rule
//   2. which of those moves is legal — the king's rule
//   3. when the game is over — the ending rule
// ============================================================

<# ../मूल/अष्टापदम् => अ
<# ../मूल/चालाः => च
<# ../मूल/नियमाः => नि
<# ./आकृतिः => आ

निवेदनम्(नाम, वास्तवम्, अपेक्षितम्, दोषाः<~) {
    ? वास्तवम् == अपेक्षितम् {
        >> "  ok    " नाम ¶
    } _ {
        >> "  FAIL  " नाम "   expected " अपेक्षितम् ", got " वास्तवम् ¶
        दोषाः = दोषाः + 1
    }
}

// एकस्मात् पदात् चालानां संख्या।
गणना(स्थितिः, पदपाठः) { <~ (च::अङ्गचालाः(स्थितिः, आ::पदपाठः(पदपाठः)))$# }

// अस्ति वा एषः चालः?
अस्ति(स्थितिः, आदिः, अन्तः) {
    लक्ष्यम् = अ::चालरचना(आ::पदपाठः(आदिः), आ::पदपाठः(अन्तः))
    @ चालः : च::अङ्गचालाः(स्थितिः, आ::पदपाठः(आदिः)) {
        ? चालः == लक्ष्यम् { <~ #1 }
    }
    <~ #0
}

दोषाः = 0
>> "चतुरङ्गम् — rule engine tests" ¶
>> "" ¶

// ------------------------------------------------------------
// अङ्गानां गतिः — प्राचीनस्य चतुरङ्गस्य, न आधुनिकस्य शतरञ्जस्य
// EN: piece movement — historical chaturanga, not modern chess
>> "अङ्गगतिः — how the pieces move" ¶

_रिक्तम् = आ::पठनम्([
    "........",
    "........",
    "........",
    "........",
    "........",
    "........",
    "........",
    "........"
])

// मन्त्री: एकम् एव पदं तिर्यक्। आधुनिकी राज्ञी अष्टाविंशतिं
// पदानि प्राप्नुयात्; अयं चत्वारि।
// EN: the counsellor is a ferz, not a queen — four squares from the
// centre, where a queen would have twenty-eight.
मन्त्रिस्थितिः = अ::नवम्()
अ::स्थापनम्(मन्त्रिस्थितिः<~, 4, 4, अ::रचना(1, 5))
निवेदनम्("counsellor has 4 moves, not 28", गणना(मन्त्रिस्थितिः, "d4"), 4, दोषाः<~)
निवेदनम्("counsellor goes diagonally", अस्ति(मन्त्रिस्थितिः, "d4", "e5"), #1, दोषाः<~)
निवेदनम्("counsellor does not go straight", अस्ति(मन्त्रिस्थितिः, "d4", "d5"), #0, दोषाः<~)
निवेदनम्("counsellor does not go far", अस्ति(मन्त्रिस्थितिः, "d4", "f6"), #0, दोषाः<~)

// गजः: द्वे पदे तिर्यक्, उत्प्लुत्य। अष्टौ एव पदानि तेन गम्यानि।
// EN: the elephant jumps exactly two diagonally and reaches only
// eight squares of the board.
गजस्थितिः = अ::नवम्()
अ::स्थापनम्(गजस्थितिः<~, 4, 4, अ::रचना(1, 3))
निवेदनम्("elephant has 4 jumps", गणना(गजस्थितिः, "d4"), 4, दोषाः<~)
निवेदनम्("elephant jumps two", अस्ति(गजस्थितिः, "d4", "f6"), #1, दोषाः<~)
निवेदनम्("elephant skips one", अस्ति(गजस्थितिः, "d4", "e5"), #0, दोषाः<~)

// गजः मध्यपदम् अतिक्रामति — तत् एव तस्य विशेषः।
// EN: the elephant leaps over whatever stands between, which is the
// whole point of it.
गजबाधा = आ::पठनम्([
    "........",
    "........",
    "........",
    "....P...",
    "...B....",
    "........",
    "........",
    "........"
])
निवेदनम्("elephant leaps over a piece", अस्ति(गजबाधा, "d4", "f6"), #1, दोषाः<~)

// रथः: दूरं सरति, स्वेन रुध्यते, रिपुम् आहत्य तिष्ठति।
// EN: the chariot slides, is blocked by its own and stops on an
// enemy having taken it.
रथस्थितिः = आ::पठनम्([
    "........",
    "........",
    "...p....",
    "........",
    "...R..P.",
    "........",
    "........",
    "........"
])
निवेदनम्("chariot takes the enemy and stops", अस्ति(रथस्थितिः, "d4", "d6"), #1, दोषाः<~)
निवेदनम्("chariot does not pass through it", अस्ति(रथस्थितिः, "d4", "d7"), #0, दोषाः<~)
निवेदनम्("chariot stops before its own", अस्ति(रथस्थितिः, "d4", "f4"), #1, दोषाः<~)
निवेदनम्("chariot does not take its own", अस्ति(रथस्थितिः, "d4", "g4"), #0, दोषाः<~)

// अश्वः: यथा शतरञ्जे तथैव — एतत् एकम् एव अङ्गं यत् सहस्रवर्षेषु
// न परिवर्तितम्।
// EN: the horse moves as it always has — the one piece that two
// thousand years left alone.
अश्वस्थितिः = अ::नवम्()
अ::स्थापनम्(अश्वस्थितिः<~, 4, 4, अ::रचना(1, 2))
निवेदनम्("horse has 8 moves from the centre", गणना(अश्वस्थितिः, "d4"), 8, दोषाः<~)
अ::स्थापनम्(अश्वस्थितिः<~, 4, 4, 0)
अ::स्थापनम्(अश्वस्थितिः<~, 1, 1, अ::रचना(1, 2))
निवेदनम्("horse has 2 moves from the corner", गणना(अश्वस्थितिः, "a1"), 2, दोषाः<~)

// पत्तिः: एकम् एव पदम्, आदावपि। न द्विपदप्रयाणम्।
// EN: the foot soldier takes one step, always — there is no double
// first move in this game.
पत्तिस्थितिः = आ::पठनम्([
    "........",
    "........",
    "........",
    "........",
    "........",
    "...p.p..",
    "....P...",
    "........"
])
निवेदनम्("foot soldier steps one", अस्ति(पत्तिस्थितिः, "e2", "e3"), #1, दोषाः<~)
निवेदनम्("foot soldier has no double step", अस्ति(पत्तिस्थितिः, "e2", "e4"), #0, दोषाः<~)
निवेदनम्("foot soldier takes diagonally", अस्ति(पत्तिस्थितिः, "e2", "d3"), #1, दोषाः<~)
निवेदनम्("foot soldier takes on the other side too", अस्ति(पत्तिस्थितिः, "e2", "f3"), #1, दोषाः<~)
निवेदनम्("three moves in all", गणना(पत्तिस्थितिः, "e2"), 3, दोषाः<~)

// सम्मुखं रिपुः चेत्, पत्तिः न गच्छति — ग्रहणं तिर्यक् एव।
// EN: a foot soldier blocked head-on cannot move at all: its
// capture is not its move.
रुद्धपत्तिः = आ::पठनम्([
    "........",
    "........",
    "........",
    "........",
    "........",
    "....p...",
    "....P...",
    "........"
])
निवेदनम्("blocked foot soldier is stuck", गणना(रुद्धपत्तिः, "e2"), 0, दोषाः<~)

// राजा: अष्टौ पदानि, गृहत्यागः नास्ति।
// EN: the king has eight moves and does not castle.
राजस्थितिः = अ::नवम्()
अ::स्थापनम्(राजस्थितिः<~, 4, 4, अ::रचना(1, 6))
निवेदनम्("king has 8 moves", गणना(राजस्थितिः, "d4"), 8, दोषाः<~)

// ------------------------------------------------------------
// प्रवर्धनम् — पत्तिः मन्त्री एव भवति, अन्यत् किमपि न
// EN: promotion — to a counsellor and to nothing else
>> "" ¶
>> "प्रवर्धनम् — promotion" ¶

प्रवर्धनस्थितिः = आ::पठनम्([
    "........",
    "....P...",
    "........",
    "........",
    "........",
    "........",
    "........",
    "....K..k"
])
गृहीतम् = 0
चालः = अ::चालरचना(आ::पदपाठः("e7"), आ::पदपाठः("e8"))
नि::कृति(प्रवर्धनस्थितिः<~, चालः, गृहीतम्<~)
निवेदनम्("foot soldier became a counsellor", प्रवर्धनस्थितिः[आ::पदपाठः("e8")], अ::रचना(1, 5), दोषाः<~)
निवेदनम्("it did not become a chariot", प्रवर्धनस्थितिः[आ::पदपाठः("e8")] == अ::रचना(1, 4), #0, दोषाः<~)

// प्रत्यावर्तनं पत्तिम् एव प्रत्यागमयति, न मन्त्रिणम्। एतत् एव
// कारणं यत् इतिहासः गतम् अङ्गं धारयति।
// EN: taking the move back puts a foot soldier down again, not a
// counsellor. That is why the history records the piece that moved.
नि::प्रत्यावर्तनम्(प्रवर्धनस्थितिः<~, चालः, अ::रचना(1, 1), गृहीतम्)
निवेदनम्("undo restores a foot soldier", प्रवर्धनस्थितिः[आ::पदपाठः("e7")], अ::रचना(1, 1), दोषाः<~)
निवेदनम्("undo emptied the far rank", प्रवर्धनस्थितिः[आ::पदपाठः("e8")], 0, दोषाः<~)

// ------------------------------------------------------------
// संकटः — राजा आक्रान्तः
// EN: check
>> "" ¶
>> "संकटः — check" ¶

संकटस्थितिः = आ::पठनम्([
    "....k...",
    "........",
    "........",
    "........",
    "........",
    "........",
    "........",
    "....K..R"
])
निवेदनम्("black is not in check", नि::संकटे(संकटस्थितिः, 2), #0, दोषाः<~)

रथसंकटः = आ::पठनम्([
    "....k...",
    "........",
    "........",
    "........",
    "........",
    "........",
    "........",
    "....K..."
])
अ::स्थापनम्(रथसंकटः<~, 4, 5, अ::रचना(1, 4))
निवेदनम्("a chariot on the file gives check", नि::संकटे(रथसंकटः, 2), #1, दोषाः<~)

// स्वयं संकटं जनयन् चालः अवैधः — अङ्गं बद्धम्।
// EN: a move that exposes one's own king is not legal — the piece
// is pinned.
बद्धस्थितिः = आ::पठनम्([
    "....k...",
    "....n...",
    "........",
    "........",
    "........",
    "........",
    "........",
    "....K..R"
])
अ::स्थापनम्(बद्धस्थितिः<~, 4, 5, अ::रचना(1, 4))
बद्धचालः = अ::चालरचना(आ::पदपाठः("e7"), आ::पदपाठः("c6"))
निवेदनम्("the pinned horse could move", अस्ति(बद्धस्थितिः, "e7", "c6"), #1, दोषाः<~)
निवेदनम्("but the move is not legal", नि::वैधः(बद्धस्थितिः<~, बद्धचालः, 2), #0, दोषाः<~)

// ------------------------------------------------------------
// क्रीडायाः अन्तः
// EN: how the game ends
>> "" ¶
>> "अन्तः — how the game ends" ¶

आदिस्थितिः = अ::नवम्()
अ::सेनास्थापनम्(आदिस्थितिः<~)
निवेदनम्("the opening game goes on", नि::परिणामः(आदिस्थितिः<~, 1), 0, दोषाः<~)
निवेदनम्("white has 16 legal moves", (नि::वैधचालाः(आदिस्थितिः<~, 1))$#, 16, दोषाः<~)
निवेदनम्("black has 16 too", (नि::वैधचालाः(आदिस्थितिः<~, 2))$#, 16, दोषाः<~)

// मातः: द्वौ रथौ सोपानवत्, कृष्णस्य राजा कोणे।
//
// कृष्णस्य रुद्धः पत्तिः अपि आवश्यकः, और तस्य कारणं शिक्षाप्रदम्:
// तेन विना कृष्णस्य राजा एकाकी स्यात्, और निर्वस्त्रस्य नियमः
// प्रथमं स्पृशेत्। परीक्षायाः प्रथमे रूपे स एव न आसीत्, और
// परीक्षा "मातः" इति स्थाने "निर्वस्त्रः" इति अवदत् — सा च
// परीक्षायाः त्रुटिः आसीत्, न यन्त्रस्य।
//
// EN: checkmate — two chariots in a ladder, the black king in the
// corner.
//
// The blocked black foot soldier is load-bearing, and instructively
// so: without it the black king stands alone and the bare-king rule
// answers first. The first draft of this test did not have it and
// reported "bare king" where it wanted "mate" — which was the
// test's mistake, not the engine's.
मातस्थितिः = आ::पठनम्([
    "k.......",
    ".......p",
    "RR.....P",
    "........",
    "........",
    "........",
    "........",
    "....K..."
])
निवेदनम्("black is checkmated", नि::परिणामः(मातस्थितिः<~, 2), 1, दोषाः<~)
निवेदनम्("black is in check", नि::संकटे(मातस्थितिः, 2), #1, दोषाः<~)
निवेदनम्("black has no legal move", (नि::वैधचालाः(मातस्थितिः<~, 2))$#, 0, दोषाः<~)

// गतिरोधः: चालः नास्ति और संकटः अपि नास्ति। अस्यां क्रीडायाम्
// एषः अपि पराजयः, न समता — शतरञ्जस्य प्राचीनः नियमः।
// EN: stalemate — no legal move and no check. In this game that is
// a loss too, not a draw: the old shatranj rule.
// रथः c७ सप्तमीं पङ्क्तिं रुणद्धि, रथः b६ b-स्तम्भम्। अष्टमः
// कोणः स्वयम् अनाक्रान्तः, अतः संकटः नास्ति — किन्तु गन्तुं
// स्थानं नास्ति। रुद्धः पत्तिः अत्रापि आवश्यकः, तेन एव कारणेन।
//
// EN: The chariot on c7 seals rank 7 and the one on b6 seals the
// b-file. The corner itself is unattacked, so there is no check —
// and nowhere to go. The blocked foot soldier is needed here for
// the same reason as above.
गतिरोधस्थितिः = आ::पठनम्([
    "k.......",
    "..R....p",
    ".R.....P",
    "........",
    "........",
    "........",
    "........",
    "....K..."
])
निवेदनम्("black is stalemated", नि::परिणामः(गतिरोधस्थितिः<~, 2), 2, दोषाः<~)
निवेदनम्("and is not in check", नि::संकटे(गतिरोधस्थितिः, 2), #0, दोषाः<~)

// निर्वस्त्रः राजा: प्रतिपक्षस्य राजा एकाकी।
// EN: the bare king — the opponent has nothing but the king left.
निर्वस्त्रस्थितिः = आ::पठनम्([
    "k.......",
    "........",
    "........",
    "........",
    "........",
    "........",
    "........",
    "....K..R"
])
निवेदनम्("the bare king has lost", नि::परिणामः(निर्वस्त्रस्थितिः<~, 2), 3, दोषाः<~)

// उभौ एकाकिनौ — समता।
// EN: both kings alone is a draw.
समतास्थितिः = आ::पठनम्([
    "k.......",
    "........",
    "........",
    "........",
    "........",
    "........",
    "........",
    "....K..."
])
निवेदनम्("two bare kings is a draw", नि::परिणामः(समतास्थितिः<~, 2), 4, दोषाः<~)
निवेदनम्("and a draw from either side", नि::परिणामः(समतास्थितिः<~, 1), 4, दोषाः<~)

// ------------------------------------------------------------
// कृति और प्रत्यावर्तनम् प्रतिलोमौ
// EN: कृति and प्रत्यावर्तनम् are exact inverses — the property the
// whole search rests on. If they ever stopped being inverses, the
// engine would corrupt the board a few thousand nodes deep and
// nothing else here would notice.
>> "" ¶
>> "प्रतिलोमः — playing and taking back is the identity" ¶

मूलस्थितिः = अ::नवम्()
अ::सेनास्थापनम्(मूलस्थितिः<~)
कार्यस्थितिः = अ::प्रतिकृतिः(मूलस्थितिः)
भेदाः = 0
@ चालः : नि::वैधचालाः(कार्यस्थितिः<~, 1) {
    अङ्गम् = कार्यस्थितिः[अ::आदिपदम्(चालः)]
    गृ = 0
    नि::कृति(कार्यस्थितिः<~, चालः, गृ<~)
    नि::प्रत्यावर्तनम्(कार्यस्थितिः<~, चालः, अङ्गम्, गृ)
    @ क:1..64 {
        ? कार्यस्थितिः[क] <> मूलस्थितिः[क] { भेदाः = भेदाः + 1 }
    }
}
निवेदनम्("all 16 openings restore the board exactly", भेदाः, 0, दोषाः<~)

>> "" ¶
? दोषाः == 0 {
    >> "PASS — every rule case behaved" ¶
} _ {
    >> "FAIL — " दोषाः " problem(s)" ¶
}
