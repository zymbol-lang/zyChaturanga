// ============================================================
// मूल/चालाः.zy — अङ्गानां गतिः
//
// अत्र प्राचीनस्य चतुरङ्गस्य चालाः लिख्यन्ते, न आधुनिकस्य
// शतरञ्जस्य। भेदः त्रिषु अङ्गेषु, ते च त्रयः एव क्रीडाम् अन्यां
// कुर्वन्ति:
//
//   मन्त्री एकम् एव पदं तिर्यक् गच्छति। स आधुनिकी राज्ञी न;
//           दुर्बलतमम् अङ्गं पत्तेः अनन्तरम्।
//   गजः    द्वे पदे तिर्यक् उत्प्लवते, मध्यपदम् अतिक्रम्य।
//           अष्टौ एव पदानि तेन गम्यानि; द्वौ गजौ कदापि न मिलतः।
//   पत्तिः  एकम् एव पदम्, आदावपि। न द्विपदप्रयाणम्, न
//           गच्छति-गच्छति-ग्रहणम्, न वरणम् — मन्त्री एव भवति।
//
// राजा गृहत्यागं (castling) न करोति। तत् पञ्चदशशतकस्य यूरोपस्य
// आविष्कारः।
//
// अत्र उत्पादिताः चालाः "प्रायोवैधाः" — अङ्गस्य गतिनियमं
// पालयन्ति, किन्तु स्वराज्ञः संकटं न पश्यन्ति। तत् मूल/नियमाः.zy
// इति स्तरस्य कार्यम्। एषः भेदः आवश्यकः: संकटपरीक्षा एव चालान्
// उत्पादयति, अतः यदि उत्पादनम् एव संकटं पृच्छेत् तर्हि अनन्ता
// पुनरावृत्तिः स्यात्।
//
// EN: मूल/चालाः.zy — how the pieces move
//
// These are the moves of historical chaturanga, not of modern
// chess. Three pieces differ, and those three are the whole
// difference between the two games:
//
//   मन्त्री  one step diagonally. Not a modern queen — the weakest
//            piece after the foot soldier.
//   गजः     jumps exactly two squares diagonally, over whatever
//            stands between. It reaches only 8 of the 64 squares,
//            so two elephants on different colours never meet.
//   पत्तिः   one step, always — no double first move, no en
//            passant, and promotion is to a counsellor or nothing.
//
// The king does not castle: that is a fifteenth-century European
// invention.
//
// Moves generated here are *pseudo-legal*: they obey the piece's
// own rule and say nothing about whether they leave the mover's
// king in check. That belongs to मूल/नियमाः.zy, and the split is
// not tidiness — the check test is itself written in terms of move
// generation, so a generator that asked about check would recurse
// forever.
// ============================================================

# .मूल_चालाः {

    <# ./अष्टापदम् => अ

    #> {
        अङ्गचालाः
        सर्वचालाः
        आक्रान्तम्
    }

    // दिशः समतलेषु संग्रहेषु, द्वे द्वे संख्ये एकां दिशम् आहतुः।
    // अन्तर्निहितः संग्रहः प्रतिचालम् एकम् आवण्टनं याचते, समतलः
    // च न किमपि।
    //
    // EN: Directions live in flat arrays, two numbers to a
    // direction. A nested array would cost one allocation per
    // lookup in the innermost loop of the search; a flat one costs
    // nothing.
    _रथदिशः() { <~ [१, ०, -१, ०, ०, १, ०, -१] }
    _मन्त्रिदिशः() { <~ [१, १, १, -१, -१, १, -१, -१] }
    _राजदिशः() { <~ [१, ०, -१, ०, ०, १, ०, -१, १, १, १, -१, -१, १, -१, -१] }
    _अश्वदिशः() { <~ [२, १, २, -१, -२, १, -२, -१, १, २, १, -२, -१, २, -१, -२] }
    _गजदिशः() { <~ [२, २, २, -२, -२, २, -२, -२] }

    // एकः चालः यदि लक्ष्यं फलके अस्ति च स्वाङ्गेन न आवृतम्।
    // EN: One step, taken when the target is on the board and not
    // occupied by one's own piece.
    _पदचालः(स्थितिः, आदिः, पङ्क्तिः, स्तम्भः, वर्णः, फलम्<~) {
        ? अ::अन्तर्गतम्(पङ्क्तिः, स्तम्भः) {
            लक्ष्यम् = अ::पदम्(पङ्क्तिः, स्तम्भः)
            अङ्गम् = स्थितिः[लक्ष्यम्]
            ? अङ्गम् == ० {
                फलम् = फलम् $+ अ::चालरचना(आदिः, लक्ष्यम्)
            } _ {
                ? अ::अङ्गवर्णः(अङ्गम्) <> वर्णः {
                    फलम् = फलम् $+ अ::चालरचना(आदिः, लक्ष्यम्)
                }
            }
        }
        <~ ०
    }

    // रथस्य सरणम्: यावत् रिक्तम्, तावत् गच्छति; रिपुम् आहत्य
    // तिष्ठति; स्वम् दृष्ट्वा पूर्वम् एव तिष्ठति।
    //
    // EN: The chariot slides while the squares are empty, stops on
    // an enemy having taken it, and stops before one of its own.
    _सरणम्(स्थितिः, आदिः, पङ्क्तिः, स्तम्भः, दिप, दिस, वर्णः, फलम्<~) {
        प = पङ्क्तिः + दिप
        स = स्तम्भः + दिस
        @ अ::अन्तर्गतम्(प, स) {
            लक्ष्यम् = अ::पदम्(प, स)
            अङ्गम् = स्थितिः[लक्ष्यम्]
            ? अङ्गम् == ० {
                फलम् = फलम् $+ अ::चालरचना(आदिः, लक्ष्यम्)
            } _ {
                ? अ::अङ्गवर्णः(अङ्गम्) <> वर्णः {
                    फलम् = फलम् $+ अ::चालरचना(आदिः, लक्ष्यम्)
                }
                <~ ०
            }
            प = प + दिप
            स = स + दिस
        }
        <~ ०
    }

    _दिशि(स्थितिः, आदिः, पङ्क्तिः, स्तम्भः, वर्णः, दिशः, फलम्<~) {
        अर्धम् = (दिशः$#) / २
        @ क:१..अर्धम् {
            दिप = दिशः[क * २ - १]
            दिस = दिशः[क * २]
            _पदचालः(स्थितिः, आदिः, पङ्क्तिः + दिप, स्तम्भः + दिस, वर्णः, फलम्<~)
        }
        <~ ०
    }

    // पत्तिः। श्वेतः उपरि गच्छति, कृष्णः अधः। सम्मुखं रिक्तं चेत्
    // पदम्, तिर्यक् रिपुः चेत् ग्रहणम्। द्वे एव गतिनियमे, यौ
    // भिन्नौ — अतः पत्तिः एकम् एव अङ्गं यत् गच्छति अन्यथा
    // गृह्णाति च अन्यथा।
    //
    // EN: The foot soldier. White walks up the board, black down.
    // Forward onto an empty square, diagonally onto an enemy — the
    // only piece whose move and whose capture are different rules,
    // in this game as in chess.
    _पत्तिचालाः(स्थितिः, आदिः, पङ्क्तिः, स्तम्भः, वर्णः, फलम्<~) {
        दिप = १
        ? वर्णः == २ { दिप = -१ }

        अग्रे = पङ्क्तिः + दिप
        ? अ::अन्तर्गतम्(अग्रे, स्तम्भः) {
            लक्ष्यम् = अ::पदम्(अग्रे, स्तम्भः)
            ? स्थितिः[लक्ष्यम्] == ० {
                फलम् = फलम् $+ अ::चालरचना(आदिः, लक्ष्यम्)
            }
        }

        @ दिस : [-१, १] {
            पार्श्वम् = स्तम्भः + दिस
            ? अ::अन्तर्गतम्(अग्रे, पार्श्वम्) {
                लक्ष्यम् = अ::पदम्(अग्रे, पार्श्वम्)
                अङ्गम् = स्थितिः[लक्ष्यम्]
                ? अङ्गम् <> ० {
                    ? अ::अङ्गवर्णः(अङ्गम्) <> वर्णः {
                        फलम् = फलम् $+ अ::चालरचना(आदिः, लक्ष्यम्)
                    }
                }
            }
        }
        <~ ०
    }

    // एकस्मिन् पदे स्थितस्य अङ्गस्य सर्वे प्रायोवैधाः चालाः।
    // EN: Every pseudo-legal move of the piece standing on one
    // square.
    अङ्गचालाः(स्थितिः, स्थानम्) {
        अङ्गम् = स्थितिः[स्थानम्]
        ? अङ्गम् == ० { <~ [] }

        वर्णः = अ::अङ्गवर्णः(अङ्गम्)
        प्रकारः = अ::अङ्गप्रकारः(अङ्गम्)
        पङ्क्तिः = अ::पङ्क्त्यङ्कः(स्थानम्)
        स्तम्भः = अ::स्तम्भाङ्कः(स्थानम्)
        फलम् = []

        ?? प्रकारः {
            १ => { _पत्तिचालाः(स्थितिः, स्थानम्, पङ्क्तिः, स्तम्भः, वर्णः, फलम्<~) }
            २ => { _दिशि(स्थितिः, स्थानम्, पङ्क्तिः, स्तम्भः, वर्णः, _अश्वदिशः(), फलम्<~) }
            ३ => { _दिशि(स्थितिः, स्थानम्, पङ्क्तिः, स्तम्भः, वर्णः, _गजदिशः(), फलम्<~) }
            ४ => {
                दिशः = _रथदिशः()
                @ क:१..४ {
                    _सरणम्(स्थितिः, स्थानम्, पङ्क्तिः, स्तम्भः, दिशः[क * २ - १], दिशः[क * २], वर्णः, फलम्<~)
                }
            }
            ५ => { _दिशि(स्थितिः, स्थानम्, पङ्क्तिः, स्तम्भः, वर्णः, _मन्त्रिदिशः(), फलम्<~) }
            ६ => { _दिशि(स्थितिः, स्थानम्, पङ्क्तिः, स्तम्भः, वर्णः, _राजदिशः(), फलम्<~) }
            _ => { }
        }
        <~ फलम्
    }

    सर्वचालाः(स्थितिः, वर्णः) {
        फलम् = []
        @ स्थानम्:१..६४ {
            अङ्गम् = स्थितिः[स्थानम्]
            ? अङ्गम् <> ० {
                ? अ::अङ्गवर्णः(अङ्गम्) == वर्णः {
                    @ चालः : अङ्गचालाः(स्थितिः, स्थानम्) { फलम् = फलम् $+ चालः }
                }
            }
        }
        <~ फलम्
    }

    // लक्ष्यपदं वर्णेन आक्रान्तं वा।
    //
    // सर्वान् चालान् उत्पाद्य अन्वेषणं न क्रियते। तत् सुगमं स्यात्
    // किन्तु संकटपरीक्षा गवेषणायाः अन्तरतमे वर्तते: प्रतिचालं
    // द्विः पृच्छ्यते। अतः लक्ष्यात् एव बहिः गम्यते — यत् अङ्गं
    // माम् आहन्तुं शक्नोति, तत् एव अङ्गं तस्य गत्या मया गम्यम्
    // स्यात्। एषा युक्तिः पत्तिं विहाय सर्वेषु सिध्यति, यतः
    // पत्तेः ग्रहणं गतेः भिन्नम्।
    //
    // EN: Is this square attacked by that colour?
    //
    // Not by generating every enemy move and searching the list.
    // That reads better and is the wrong shape: the check test sits
    // in the innermost loop of the search and is asked twice per
    // move. So the walk runs *outward from the target* instead —
    // whatever could take me, I could reach by that same piece's
    // move. The symmetry holds for every piece except the foot
    // soldier, whose capture is not its move, so that one case is
    // written the other way round.
    आक्रान्तम्(स्थितिः, लक्ष्यम्, वर्णः) {
        पङ्क्तिः = अ::पङ्क्त्यङ्कः(लक्ष्यम्)
        स्तम्भः = अ::स्तम्भाङ्कः(लक्ष्यम्)

        // पत्तिः। वर्णः श्वेतः चेत्, अधस्तात् तिर्यक् आहन्ति।
        // EN: Foot soldiers: a white one attacks from below.
        पदिप = -१
        ? वर्णः == २ { पदिप = १ }
        पत्त्यङ्गम् = अ::रचना(वर्णः, १)
        @ दिस : [-१, १] {
            प = पङ्क्तिः + पदिप
            स = स्तम्भः + दिस
            ? अ::अन्तर्गतम्(प, स) {
                ? स्थितिः[अ::पदम्(प, स)] == पत्त्यङ्गम् { <~ #१ }
            }
        }

        ? _उत्प्लवात्(स्थितिः, पङ्क्तिः, स्तम्भः, वर्णः, _अश्वदिशः(), २) { <~ #१ }
        ? _उत्प्लवात्(स्थितिः, पङ्क्तिः, स्तम्भः, वर्णः, _गजदिशः(), ३) { <~ #१ }
        ? _उत्प्लवात्(स्थितिः, पङ्क्तिः, स्तम्भः, वर्णः, _मन्त्रिदिशः(), ५) { <~ #१ }
        ? _उत्प्लवात्(स्थितिः, पङ्क्तिः, स्तम्भः, वर्णः, _राजदिशः(), ६) { <~ #१ }

        रथाङ्गम् = अ::रचना(वर्णः, ४)
        दिशः = _रथदिशः()
        @ क:१..४ {
            ? _सरणात्(स्थितिः, पङ्क्तिः, स्तम्भः, दिशः[क * २ - १], दिशः[क * २], रथाङ्गम्) { <~ #१ }
        }
        <~ #०
    }

    _उत्प्लवात्(स्थितिः, पङ्क्तिः, स्तम्भः, वर्णः, दिशः, प्रकारः) {
        लक्ष्याङ्गम् = अ::रचना(वर्णः, प्रकारः)
        अर्धम् = (दिशः$#) / २
        @ क:१..अर्धम् {
            प = पङ्क्तिः + दिशः[क * २ - १]
            स = स्तम्भः + दिशः[क * २]
            ? अ::अन्तर्गतम्(प, स) {
                ? स्थितिः[अ::पदम्(प, स)] == लक्ष्याङ्गम् { <~ #१ }
            }
        }
        <~ #०
    }

    _सरणात्(स्थितिः, पङ्क्तिः, स्तम्भः, दिप, दिस, लक्ष्याङ्गम्) {
        प = पङ्क्तिः + दिप
        स = स्तम्भः + दिस
        @ अ::अन्तर्गतम्(प, स) {
            अङ्गम् = स्थितिः[अ::पदम्(प, स)]
            ? अङ्गम् <> ० {
                ? अङ्गम् == लक्ष्याङ्गम् { <~ #१ }
                <~ #०
            }
            प = प + दिप
            स = स + दिस
        }
        <~ #०
    }
}
