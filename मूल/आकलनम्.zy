// ============================================================
// मूल/आकलनम्.zy — स्थितेः मूल्याङ्कनम्
//
// एका संख्या, या वदति कस्य स्थितिः श्रेष्ठा। धनात्मकं चेत्
// पृच्छकस्य लाभः। गवेषणा एतत् एव पत्रेषु पृच्छति, अतः इदम्
// शीघ्रं भवितव्यम्।
//
// अङ्गानां मूल्यानि आधुनिकशतरञ्जात् भिन्नानि, यतः अङ्गानि एव
// भिन्नानि:
//
//   मन्त्री २००  — एकपदी तिर्यग्गतिः। आधुनिकी राज्ञी ९००।
//   गजः    १५०  — अष्टौ एव पदानि गम्यानि। द्वौ गजौ भिन्नवर्णौ
//                  कदापि न मिलतः, अतः एकः गजः अर्धं फलकम् एव
//                  पश्यति।
//   अश्वः  ३००  — सर्वाणि चतुःषष्टिः पदानि गम्यानि, अतः अत्र
//                  मन्त्रिणः गजस्य च मिलितात् अपि बलवत्तरः।
//   रथः    ५००  — एकम् एव अङ्गं यत् दूरं गच्छति। प्राचीने
//                  चतुरङ्गे रथः एव राजा — क्रीडा प्रायः तेन जीयते।
//
// एतत् एव प्राचीनस्य नूतनस्य च भेदः: तत्र क्रीडा मन्दा, फलकं
// पूर्णम्, विजयः च अङ्गमूल्येन न, अपि तु पत्तीनां प्रयाणेन।
//
// EN: मूल/आकलनम्.zy — evaluating a position
//
// One number saying who stands better, positive for the side that
// asked. The search calls this at every leaf, so it has to be
// cheap.
//
// The piece values are not chess values, because the pieces are
// not chess pieces:
//
//   मन्त्री २००  one diagonal step. A modern queen is 900.
//   गजः    १५०  reaches 8 squares of the 64 and never leaves its
//                own colour, so one elephant sees half a board.
//   अश्वः  ३००  reaches all 64 — worth more here than a counsellor
//                and an elephant together.
//   रथः    ५००  the only piece that travels. In historical
//                chaturanga the chariot is the king of the board,
//                and most games are decided by it.
//
// That is the whole difference between the old game and the new:
// here the game is slow, the board stays full, and it is won by
// walking foot soldiers rather than by trading material.
// ============================================================

# .मूल_आकलनम् {

    <# ./अष्टापदम् => अ

    #> {
        अङ्गमूल्यम्
        सारणी
        पदमूल्यम्
        मूल्याङ्कनम्
        सामग्री
        मूल्य_पत्तिः
        मूल्य_अश्वः
        मूल्य_गजः
        मूल्य_रथः
        मूल्य_मन्त्री
    }

    मूल्य_पत्तिः  := १००
    मूल्य_अश्वः   := ३००
    मूल्य_गजः     := १५०
    मूल्य_रथः     := ५००
    मूल्य_मन्त्री := २००

    // राज्ञः मूल्यं नास्ति। स कदापि न गृह्यते; तस्य अभावः
    // मातेन गण्यते, न सामग्र्या।
    // EN: The king has no value. It is never captured; its loss is
    // counted as mate, not as material.
    अङ्गमूल्यम्(प्रकारः) {
        <~ ?? प्रकारः {
            १ => १००
            २ => ३००
            ३ => १५०
            ४ => ५००
            ५ => २००
            _ => ०
        }
    }

    // पदमूल्यम्: मध्यं श्रेष्ठम्, कोणाः निकृष्टाः। श्वेतस्य दृष्ट्या
    // लिखितम्; कृष्णाय पङ्क्तिः विपर्यस्यते।
    //
    // EN: Square tables, written from white's side; black reads the
    // same table with the rank mirrored. Centre good, corners bad —
    // the one positional idea a beginner engine can be trusted with.
    _पत्तिपदानि() {
        <~ [
            ०,  ०,  ०,  ०,  ०,  ०,  ०,  ०,
            ०,  ०,  ०,  ०,  ०,  ०,  ०,  ०,
            ५,  ५, १०, १५, १५, १०,  ५,  ५,
           १०, १०, १५, २०, २०, १५, १०, १०,
           २०, २०, २५, ३०, ३०, २५, २०, २०,
           ४०, ४०, ४५, ५०, ५०, ४५, ४०, ४०,
           ७०, ७०, ७५, ८०, ८०, ७५, ७०, ७०,
            ०,  ०,  ०,  ०,  ०,  ०,  ०,  ०
        ]
    }

    _अश्वपदानि() {
        <~ [
          -३०, -२०, -१०, -१०, -१०, -१०, -२०, -३०,
          -२०,   ०,   ५,   ५,   ५,   ५,   ०, -२०,
          -१०,   ५,  १५,  १५,  १५,  १५,   ५, -१०,
          -१०,   ५,  १५,  २०,  २०,  १५,   ५, -१०,
          -१०,   ५,  १५,  २०,  २०,  १५,   ५, -१०,
          -१०,   ५,  १५,  १५,  १५,  १५,   ५, -१०,
          -२०,   ०,   ५,   ५,   ५,   ५,   ०, -२०,
          -३०, -२०, -१०, -१०, -१०, -१०, -२०, -३०
        ]
    }

    // गजस्य पदमूल्यम् अल्पम्। स यत्र स्थितः तत्र एव अष्टौ पदानि
    // पश्यति; तस्य स्थानं तस्य भाग्यम् एव, न कौशलम्।
    // EN: The elephant's table is nearly flat. It sees the same
    // eight squares wherever it stands — its placement is its fate,
    // not its skill.
    _गजपदानि() {
        <~ [
            ०,  ०,  ०,  ०,  ०,  ०,  ०,  ०,
            ०,  ५,  ०,  ०,  ०,  ०,  ५,  ०,
            ०,  ०,  ५,  ०,  ०,  ५,  ०,  ०,
            ०,  ०,  ०, १०, १०,  ०,  ०,  ०,
            ०,  ०,  ०, १०, १०,  ०,  ०,  ०,
            ०,  ०,  ५,  ०,  ०,  ५,  ०,  ०,
            ०,  ५,  ०,  ०,  ०,  ०,  ५,  ०,
            ०,  ०,  ०,  ०,  ०,  ०,  ०,  ०
        ]
    }

    _रथपदानि() {
        <~ [
            ०,  ०,  ५, १०, १०,  ५,  ०,  ०,
           -५,  ०,  ०,  ५,  ५,  ०,  ०, -५,
           -५,  ०,  ०,  ५,  ५,  ०,  ०, -५,
           -५,  ०,  ०,  ५,  ५,  ०,  ०, -५,
           -५,  ०,  ०,  ५,  ५,  ०,  ०, -५,
           -५,  ०,  ०,  ५,  ५,  ०,  ०, -५,
           १०, १५, १५, १५, १५, १५, १५, १०,
            ०,  ०,  ५, १०, १०,  ५,  ०,  ०
        ]
    }

    _मन्त्रिपदानि() {
        <~ [
          -१०,  -५,  -५,  -५,  -५,  -५,  -५, -१०,
           -५,   ०,   ०,   ५,   ५,   ०,   ०,  -५,
           -५,   ०,   ५,  १०,  १०,   ५,   ०,  -५,
           -५,   ५,  १०,  १५,  १५,  १०,   ५,  -५,
           -५,   ५,  १०,  १५,  १५,  १०,   ५,  -५,
           -५,   ०,   ५,  १०,  १०,   ५,   ०,  -५,
           -५,   ०,   ०,   ५,   ५,   ०,   ०,  -५,
          -१०,  -५,  -५,  -५,  -५,  -५,  -५, -१०
        ]
    }

    // राजा गृहे तिष्ठतु यावत् सेना जीवति। अन्ते तु मध्यं गच्छेत्,
    // किन्तु तस्य भेदः अत्र न क्रियते: प्राचीने चतुरङ्गे अन्तः
    // अपि दीर्घः, सेना च प्रायः न क्षीयते।
    //
    // EN: The king stays home while it has an army. It should walk
    // to the centre in a bare endgame, and that distinction is not
    // drawn here: in this game the endgame is long and the army
    // rarely thins out enough for it to matter.
    _राजपदानि() {
        <~ [
           २०,  ३०,  १०,   ०,   ०,  १०,  ३०,  २०,
           २०,  २०,   ०,   ०,   ०,   ०,  २०,  २०,
          -१०, -२०, -२०, -२०, -२०, -२०, -२०, -१०,
          -२०, -३०, -३०, -४०, -४०, -३०, -३०, -२०,
          -३०, -४०, -४०, -५०, -५०, -४०, -४०, -३०,
          -३०, -४०, -४०, -५०, -५०, -४०, -४०, -३०,
          -३०, -४०, -४०, -५०, -५०, -४०, -४०, -३०,
          -३०, -४०, -४०, -५०, -५०, -४०, -४०, -३०
        ]
    }

    // षट् सारण्यः एकस्मिन् समतले संग्रहे, प्रत्येकं चतुःषष्टिः।
    // अङ्कः = (प्रकारः - १) × ६४ + पदम्।
    //
    // एकः संग्रहः, न षट्। कारणं मापितम्: पूर्वस्मिन् रूपे प्रत्येकं
    // अङ्गं स्वस्य सारणीं नवीनां रचयति स्म — द्वात्रिंशत् अङ्गानि,
    // प्रतिपत्रं द्वे सहस्रे आवण्टनानि। सारणी बहिः एकवारं रच्यते,
    // गवेषणा च ताम् एव सर्वेषु पत्रेषु नयति।
    //
    // EN: Six tables in one flat array, 64 entries each, indexed
    // (kind - 1) × 64 + square.
    //
    // One array, not six, and the reason was measured: in the first
    // version every piece built its own table afresh — 32 pieces,
    // two thousand allocations per leaf. The table is built once
    // outside the search and carried down to every leaf.
    सारणी() {
        फलम् = []
        @ म : _पत्तिपदानि() { फलम् = फलम् $+ म }
        @ म : _अश्वपदानि() { फलम् = फलम् $+ म }
        @ म : _गजपदानि() { फलम् = फलम् $+ म }
        @ म : _रथपदानि() { फलम् = फलम् $+ म }
        @ म : _मन्त्रिपदानि() { फलम् = फलम् $+ म }
        @ म : _राजपदानि() { फलम् = फलम् $+ म }
        <~ फलम्
    }

    // कृष्णाय पङ्क्तिः विपर्यस्यते; सारणी श्वेतस्य दृष्ट्या लिखिता।
    // EN: Black reads the same table with the rank mirrored.
    पदमूल्यम्(सारणी, प्रकारः, वर्णः, स्थानम्) {
        ? प्रकारः == ० { <~ ० }
        अङ्कः = स्थानम्
        ? वर्णः == २ {
            पङ्क्तिः = अ::पङ्क्त्यङ्कः(स्थानम्)
            अङ्कः = स्थानम् - (पङ्क्तिः - १) * ८ + (८ - पङ्क्तिः) * ८
        }
        <~ सारणी[(प्रकारः - १) * ६४ + अङ्कः]
    }

    // केवलं सामग्री, विना स्थानेन। परीक्षा एतत् पृथक् पृच्छति।
    // EN: Material alone, without placement — the tests ask for
    // this on its own.
    सामग्री(स्थितिः, वर्णः) {
        कुलम् = ०
        @ स्थानम्:१..६४ {
            अङ्गम् = स्थितिः[स्थानम्]
            ? अङ्गम् <> ० {
                ? अ::अङ्गवर्णः(अङ्गम्) == वर्णः {
                    कुलम् = कुलम् + अङ्गमूल्यम्(अ::अङ्गप्रकारः(अङ्गम्))
                }
            }
        }
        <~ कुलम्
    }

    // पूर्णं मूल्याङ्कनम्, वर्णस्य दृष्ट्या।
    //
    // गतिस्वातन्त्र्यं न गण्यते। तस्य गणना सर्वचालानाम् उत्पादनं
    // याचते, तत् च मूल्याङ्कनस्य द्विगुणः व्ययः, प्रत्येकस्मिन्
    // पत्रे। सामग्री च स्थानं च एतस्याः क्रीडायाः बलं वक्तुं
    // पर्याप्ते।
    //
    // EN: The whole evaluation, from one colour's side.
    //
    // Mobility is not counted. Counting it means generating every
    // move, which doubles the cost of the leaf — and in a game this
    // slow, material and placement already say who is winning.
    मूल्याङ्कनम्(स्थितिः, वर्णः, सारणी) {
        कुलम् = ०
        @ स्थानम्:१..६४ {
            अङ्गम् = स्थितिः[स्थानम्]
            ? अङ्गम् <> ० {
                अङ्गवर्णः = १
                प्रकारः = अङ्गम्
                ? अङ्गम् > ६ {
                    अङ्गवर्णः = २
                    प्रकारः = अङ्गम् - ६
                }
                अंशः = अङ्गमूल्यम्(प्रकारः) + पदमूल्यम्(सारणी, प्रकारः, अङ्गवर्णः, स्थानम्)
                ? अङ्गवर्णः == वर्णः {
                    कुलम् = कुलम् + अंशः
                } _ {
                    कुलम् = कुलम् - अंशः
                }
            }
        }
        <~ कुलम्
    }
}
