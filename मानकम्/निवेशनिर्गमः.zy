// ============================================================
// मानकम्/निवेशनिर्गमः.zy — std/io इति स्तरस्य संस्कृतम् आवरणम्
//
// EN: मानकम्/निवेशनिर्गमः.zy — Sanskrit layer over std/io.
// ============================================================

# .मानकम्_निवेशनिर्गमः {

    #> {
        निनि::read   => पठनम्
        निनि::write  => लेखनम्
        निनि::append => योजनम्
        निनि::exists => अस्ति
        निनि::delete => नाशनम्
        निनि::list   => सूची
        निनि::mkdir  => कोशरचना
    }

    <# std/io => निनि
}
