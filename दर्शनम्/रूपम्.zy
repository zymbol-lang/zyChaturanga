// ============================================================
// दर्शनम्/रूपम्.zy — अङ्गानां रूपाणि, फलकस्य रूपाणि, विन्यासस्य गणितम्
//
// द्विस्तम्भस्य नियमः
// फलकस्य प्रत्येकः कोष्ठः, यस्मिन् कस्मिन्नपि रूपे, पटलस्य द्वौ
// स्तम्भौ ठीकं गृह्णाति। कारणं GO इति क्रीडायाः अनुभवः: यदि
// कोष्ठस्य विस्तारः तस्य अन्तर्वस्तुना बध्येत, तर्हि अङ्गे स्थापिते
// पङ्क्तेः अङ्कः चलेत्।
//
// अत्र तु तस्य समाधानम् एकम् एव कार्यम्: अक्षरम्::कोष्ठपूरणम्।
// यत्किमपि चिह्नं मीयते और द्वौ स्तम्भौ यावत् पूर्यते। अतः रूपाणां
// संख्या वर्धेत अपि, नियमः न भिद्यते।
//
// चत्वारि रूपाणि, कारणैः सह:
//
//   शतरञ्जम्  ♔♕♖♗♘♙ / ♚♛♜♝♞♟ — भेदः चिह्ने एव, वर्णे न। अतः
//             वर्णरहितेऽपि पटले पठनीयम्।
//   चित्रम्    चित्राणि — सुन्दराणि किन्तु उभयोः पक्षयोः समानि।
//             अतः अस्मिन् रूपे कोष्ठस्य पृष्ठवर्णः पक्षं वदति,
//             न फलकस्य चित्रम्। एतत् मूल्यम्, न दोषः।
//   अक्षरम्   प अ ग र म रा — देवनागर्यां उच्चनीचभेदः नास्ति, अतः
//             एतदपि वर्णम् अपेक्षते।
//   लातिनम्   P N B R Q K / p n b r q k — यत्र किमपि न कल्पते।
//
// EN: दर्शनम्/रूपम्.zy — piece sets, board styles, layout arithmetic
//
// THE TWO-COLUMN RULE
// Every cell occupies exactly two terminal columns in every theme.
// The go engine learned why the hard way: if a cell's width depends
// on what is in it, the row label jitters the moment a piece lands
// in the last file.
//
// Here one function settles it — अक्षरम्::कोष्ठपूरणम् measures the
// glyph and pads to two. Themes can be added without touching the
// rule.
//
// Four piece sets, each with a reason:
//
//   शतरञ्जम्  ♔♕♖♗♘♙ / ♚♛♜♝♞♟ — the side is in the glyph, not in
//             the colour, so it reads on a monochrome terminal.
//   चित्रम्    pictures — handsome, and identical for both sides.
//             So in this theme the cell background says which side
//             a piece belongs to and the board pattern is not
//             drawn. That is the price, and it is stated rather
//             than hidden.
//   अक्षरम्   प अ ग र म रा — Devanagari has no letter case, so this
//             one needs colour too.
//   लातिनम्   P N B R Q K / p n b r q k — for terminals where
//             nothing fancy renders.
// ============================================================

# .दर्शनम्_रूपम् {

    <# ../मूल/अष्टापदम् => अ
    <# ./अक्षरम् => अक्ष

    #> {
        रूपसूची
        रूपसूत्रम्
        अङ्गचिह्नम्
        कोष्ठम्
        पक्षवर्णेन
        फलकसूची
        फलकसूत्रम्
        चिह्नितम्
        कोष्ठपृष्ठम्
        अङ्गपुरोवर्णः
        स्तम्भनाम
        फलकविस्तारः
        खण्डविस्तारः
        खण्डोच्चता
        पार्श्वविस्तारः
        न्यूनविस्तारः
        न्यूनोच्चता_अधः
        पार्श्वन्यूनविस्तारः
        न्यूनोच्चता_पार्श्वे
        विन्यासः
        विन्यासः_अशक्यः
        विन्यासः_अधः
        विन्यासः_पार्श्वे
    }

    // विन्यासस्य प्रकाराः। धनात्मकाः एव: मॉड्यूलस्य नियतांशः
    // शुद्धः अङ्कः भवितव्यः।
    // EN: Layout modes, positive only — a module constant must be a
    // bare literal.
    विन्यासः_अशक्यः := ०
    विन्यासः_अधः    := १
    विन्यासः_पार्श्वे := २

    पार्श्वविस्तारः := २६

    रूपसूची() { <~ ["शतरञ्जम्", "चित्रम्", "अक्षरम्", "लातिनम्"] }

    रूपसूत्रम्(रूपम्) {
        <~ ?? रूपम् {
            "चित्रम्"  => "रूप.चित्रम्"
            "अक्षरम्" => "रूप.अक्षरम्"
            "लातिनम्" => "रूप.लातिनम्"
            _          => "रूप.शतरञ्जम्"
        }
    }

    // अस्मिन् रूपे पक्षः वर्णेन एव ज्ञायते, न चिह्नेन।
    // EN: In these themes the side is carried by colour, not by the
    // glyph — the drawing layer asks before it chooses a background.
    पक्षवर्णेन(रूपम्) {
        ? रूपम् == "चित्रम्" { <~ #१ }
        ? रूपम् == "अक्षरम्" { <~ #१ }
        <~ #०
    }

    _शतरञ्जचिह्नम्(वर्णः, प्रकारः) {
        ? वर्णः == १ {
            <~ ?? प्रकारः {
                १ => "♙"
                २ => "♘"
                ३ => "♗"
                ४ => "♖"
                ५ => "♕"
                ६ => "♔"
                _ => " "
            }
        }
        <~ ?? प्रकारः {
            १ => "♟"
            २ => "♞"
            ३ => "♝"
            ४ => "♜"
            ५ => "♛"
            ६ => "♚"
            _ => " "
        }
    }

    // चतुरङ्गम् = चत्वारि अङ्गानि। चित्राणि तान्येव वदन्ति:
    // पदातिः, अश्वः, गजः, रथस्य चक्रम् — और तयोः उपरि मन्त्री
    // मुकुटं च।
    //
    // EN: चतुरङ्गम् means four limbs, and the pictures say so: a
    // walker, a horse, an elephant, a chariot's wheel — and above
    // them the counsellor and the crown.
    _चित्रचिह्नम्(प्रकारः) {
        <~ ?? प्रकारः {
            १ => "🚶"
            २ => "🐎"
            ३ => "🐘"
            ४ => "🛞"
            ५ => "🧙"
            ६ => "👑"
            _ => "  "
        }
    }

    // "र" रथस्य, "रा" राज्ञः। द्वयोः भेदः मात्रया एव, और "रा"
    // द्वौ स्तम्भौ गृह्णाति यत्र "र" एकम् — कोष्ठपूरणम् एतत्
    // स्वयं समीकरोति।
    //
    // EN: "र" for the chariot, "रा" for the king — one vowel sign
    // apart, and two columns against one. कोष्ठपूरणम् levels them
    // without either of them knowing.
    _अक्षरचिह्नम्(प्रकारः) {
        <~ ?? प्रकारः {
            १ => "प"
            २ => "अ"
            ३ => "ग"
            ४ => "र"
            ५ => "म"
            ६ => "रा"
            _ => " "
        }
    }

    _लातिनचिह्नम्(वर्णः, प्रकारः) {
        अक्षरम् = ?? प्रकारः {
            १ => "P"
            २ => "N"
            ३ => "B"
            ४ => "R"
            ५ => "Q"
            ६ => "K"
            _ => " "
        }
        ? वर्णः == २ {
            <~ ?? प्रकारः {
                १ => "p"
                २ => "n"
                ३ => "b"
                ४ => "r"
                ५ => "q"
                ६ => "k"
                _ => " "
            }
        }
        <~ अक्षरम्
    }

    अङ्गचिह्नम्(रूपम्, अङ्गम्) {
        ? अङ्गम् == ० { <~ " " }
        वर्णः = अ::अङ्गवर्णः(अङ्गम्)
        प्रकारः = अ::अङ्गप्रकारः(अङ्गम्)
        ?? रूपम् {
            "चित्रम्"  => { <~ _चित्रचिह्नम्(प्रकारः) }
            "अक्षरम्" => { <~ _अक्षरचिह्नम्(प्रकारः) }
            "लातिनम्" => { <~ _लातिनचिह्नम्(वर्णः, प्रकारः) }
            _          => { <~ _शतरञ्जचिह्नम्(वर्णः, प्रकारः) }
        }
    }

    // एकः कोष्ठः, सदा द्वौ स्तम्भौ।
    // EN: One cell, always two columns.
    कोष्ठम्(रूपम्, अङ्गम्, पूरकम्) {
        <~ अक्ष::कोष्ठपूरणम्(अङ्गचिह्नम्(रूपम्, अङ्गम्), पूरकम्)
    }

    // ---- फलकस्य रूपाणि ------------------------------------------
    फलकसूची() { <~ ["अष्टापदम्", "चित्रितम्"] }

    फलकसूत्रम्(फलकम्) {
        ? फलकम् == "चित्रितम्" { <~ "फलक.चित्रितम्" }
        <~ "फलक.अष्टापदम्"
    }

    // अष्टापदस्य चिह्निताः कोष्ठाः। प्राचीनं फलकं कृष्णश्वेतं न
    // आसीत् — तत् समवर्णम्, केषुचित् कोष्ठेषु च क्रॉसचिह्नम्।
    // चतुर्षु स्तम्भेषु (अ, द, ए, ह) चतसृषु च पङ्क्तिषु (१, ४, ५, ८)
    // तेषां संगमः — षोडश कोष्ठाः।
    //
    // वर्णितं फलकं यूरोपे एव जातम्, अष्टापदस्य शताब्दीभिः अनन्तरम्।
    // अतः द्वे रूपे: यत् आसीत्, यच्च अद्य प्रचलितम्।
    //
    // EN: The marked cells of an ashtapada. The old board was not
    // chequered — it was one colour with a cross drawn in certain
    // cells: files a, d, e, h crossed with ranks 1, 4, 5, 8, which
    // is sixteen of them.
    //
    // The chequered board is a European invention, centuries after
    // this game. Hence two styles: the board it was played on, and
    // the board everyone recognises.
    चिह्नितम्(पङ्क्तिः, स्तम्भः) {
        प = #०
        स = #०
        ? पङ्क्तिः == १ { प = #१ }
        ? पङ्क्तिः == ४ { प = #१ }
        ? पङ्क्तिः == ५ { प = #१ }
        ? पङ्क्तिः == ८ { प = #१ }
        ? स्तम्भः == १ { स = #१ }
        ? स्तम्भः == ४ { स = #१ }
        ? स्तम्भः == ५ { स = #१ }
        ? स्तम्भः == ८ { स = #१ }
        ? प {
            ? स { <~ #१ }
        }
        <~ #०
    }

    // कोष्ठस्य पृष्ठवर्णः, २५६-वर्णसंकेतेषु।
    //
    // पक्षवर्णेन रूपे पृष्ठं पक्षं वदति, न फलकम्। अन्यत्र फलकस्य
    // रूपम् एव निर्णयति।
    //
    // EN: The cell's background, as a 256-colour code.
    //
    // In a theme where colour carries the side, the background says
    // whose piece it is and the board pattern steps aside. In the
    // others the board style decides.
    कोष्ठपृष्ठम्(फलकम्, रूपम्, अङ्गम्, पङ्क्तिः, स्तम्भः) {
        ? पक्षवर्णेन(रूपम्) {
            ? अङ्गम् <> ० {
                ? अ::अङ्गवर्णः(अङ्गम्) == १ { <~ १८० }
                <~ ९४
            }
        }
        ? फलकम् == "चित्रितम्" {
            ? _प्रकाशः(पङ्क्तिः, स्तम्भः) { <~ १८० }
            <~ ९४
        }
        ? चिह्नितम्(पङ्क्तिः, स्तम्भः) { <~ १३७ }
        <~ १७९
    }

    _प्रकाशः(पङ्क्तिः, स्तम्भः) {
        योगः = पङ्क्तिः + स्तम्भः
        <~ (योगः - (योगः / २) * २) == ०
    }

    अङ्गपुरोवर्णः(वर्णः) {
        ? वर्णः == १ { <~ २३१ }
        <~ १६
    }

    // स्तम्भानाम् अक्षराणि। अन्तर्राष्ट्रीयानि a..h, यतः पदावली
    // सर्वत्र एका। अङ्काः तु भाषानुसारेण परिवर्तन्ते — तत् अङ्कलिपिः
    // स्वयं करोति, न इदं कार्यम्।
    //
    // EN: File letters a..h, the international convention, because
    // move notation is shared across every language. The rank
    // digits do change with the language, and that happens in the
    // numeral mode rather than here.
    स्तम्भनाम(स्तम्भः) {
        सूची = "abcdefgh"
        <~ सूची$[स्तम्भः..स्तम्भः]
    }

    // ---- मानानि -------------------------------------------------
    // वामावकाशः ३ (" ८ ") · फलकम् २ × ८ · दक्षिणलेखः २ (" ८")
    // EN: gutter 3, grid 2 × 8, right label 2
    फलकविस्तारः() { <~ १६ }
    खण्डविस्तारः() { <~ २१ }
    खण्डोच्चता() { <~ १० }

    न्यूनविस्तारः() { <~ २३ }
    न्यूनोच्चता_अधः() { <~ १५ }

    पार्श्वन्यूनविस्तारः() { <~ ४९ }
    न्यूनोच्चता_पार्श्वे() { <~ १३ }

    विन्यासः(विस्तारः, उच्चता) {
        ? विस्तारः >= ४९ {
            ? उच्चता >= १३ { <~ २ }
        }
        ? विस्तारः >= २३ {
            ? उच्चता >= १५ { <~ १ }
        }
        <~ ०
    }
}
