// ============================================================
// दर्शनम्/चित्रणम्.zy — फलकस्य, खण्डस्य, पटलानां च चित्रणम्
//
// अत्र किमपि न निर्णीयते। किं वैधम् इति मूल/ वदति, किं भवति इति
// क्रीडा.zy, कथं दृश्यते इति एतत्। यत् क्रीडकः पठति, तत् सर्वं
// सूत्रेण भाषा/ इत्यस्मात् आगच्छति — अत्र एकमपि वाक्यं न रच्यते।
//
// पङ्क्तेः क्रमः: क्रीडायाः पङ्क्तिः १ श्वेतस्य गृहम्, दृश्यते च
// अधः। अतः विपर्ययः अत्रैव भवति, एकस्मिन् एव सूत्रे, और मूलं
// तत् कदापि न जानाति।
//
// पङ्क्तिपाठः() इति कार्यं वर्णरहितं पाठं रचयति। तत् द्विकार्यम्:
// परीक्षा तेन स्तम्भान् गणयति (पटलं विना), और पटलरहिते वातावरणे
// स्थितिः तेन एव मुद्र्यते।
//
// EN: दर्शनम्/चित्रणम्.zy — drawing the board, the panel, the screens
//
// Nothing is decided here. मूल/ decides what is legal, क्रीडा.zy
// decides what happens, and this decides how it looks. Every string
// a player reads arrives through a key from भाषा/ — not one
// sentence is written here.
//
// Row order: engine rank 1 is white's home and is drawn at the
// bottom, so the flip happens here, in one expression, and the
// engine never learns about it.
//
// पङ्क्तिपाठः() builds a colourless row of text. It earns its place
// twice: the tests count columns with it without needing a
// terminal, and a position can be dumped with it where there is no
// terminal at all.
// ============================================================

# .दर्शनम्_चित्रणम् {

    <# ../मूल/अष्टापदम् => अ
    <# ./रूपम् => रू
    <# ./अक्षरम् => अक्ष
    <# ../भाषा/प्रेषकः => भा

    #> {
        पङ्क्तिपाठः
        फलकपाठः
        फलकचित्रणम्
        कोष्ठचित्रणम्
        खण्डचित्रणम्
        अधःखण्डः
        वार्ताचित्रणम्
        सज्जाचित्रणम्
        अन्तचित्रणम्
        साहाय्यचित्रणम्
        पदनाम
        चालनाम
        फलकोर्ध्वम्
        फलकवामम्
        पङ्क्तिचित्रम्
        स्तम्भचित्रम्
    }

    // ---- पदावली -------------------------------------------------
    // स्तम्भः लातिनाक्षरेण, पङ्क्तिः अङ्केन — और अङ्कः वर्तमानायाः
    // अङ्कलिप्याः। अतः एकम् एव पदम् "e४" इति संस्कृते, "e۴" इति
    // फ़ारस्याम्, "e4" इति आङ्ग्ले।
    //
    // EN: File as a Latin letter, rank as a digit — and the digit
    // comes out in whatever numeral script the locale chose. So one
    // square is "e४" in Sanskrit, "e۴" in Persian and "e4" in
    // English, from the same line of code.
    पदनाम(स्थानम्) {
        अक्षरम् = रू::स्तम्भनाम(अ::स्तम्भाङ्कः(स्थानम्))
        पङ्क्तिः = अ::पङ्क्त्यङ्कः(स्थानम्)
        <~ "{अक्षरम्}{पङ्क्तिः}"
    }

    चालनाम(चालः) {
        ? चालः == ० { <~ "—" }
        आदिः = पदनाम(अ::आदिपदम्(चालः))
        अन्तः = पदनाम(अ::अन्तपदम्(चालः))
        <~ "{आदिः}–{अन्तः}"
    }

    // ---- वर्णरहितः पाठः ------------------------------------------
    // एका पङ्क्तिः, ठीकं षोडश स्तम्भाः, यत् किमपि तस्याम् अस्तु।
    // EN: One row, exactly sixteen columns, whatever stands on it.
    पङ्क्तिपाठः(स्थितिः, रूपम्, पङ्क्तिः) {
        पाठः = ""
        @ स्तम्भः:१..८ {
            अङ्गम् = अ::ग्रहणम्(स्थितिः, पङ्क्तिः, स्तम्भः)
            कोष्ठः = रू::कोष्ठम्(रूपम्, अङ्गम्, " ")
            पाठः = "{पाठः}{कोष्ठः}"
        }
        <~ पाठः
    }

    // पूर्णं फलकं पाठरूपेण, पटलं विना। अष्टमी पङ्क्तिः अग्रे।
    // EN: The whole board as text, with no terminal. Rank 8 first.
    फलकपाठः(स्थितिः, रूपम्) {
        फलम् = ""
        @ अनुक्रमः:१..८ {
            पङ्क्तिः = ८ - अनुक्रमः + १
            रेखा = पङ्क्तिपाठः(स्थितिः, रूपम्, पङ्क्तिः)
            फलम् = "{फलम्}{पङ्क्तिः} {रेखा}
"
        }
        <~ फलम्
    }

    // ---- पटलस्य निर्देशाङ्काः ------------------------------------
    // पङ्क्तिः १ अधः दृश्यते, अतः विपर्ययः। एकम् एव स्थानं यत्र
    // एतत् गण्यते।
    //
    // EN: Rank 1 is drawn at the bottom, so the flip lives here and
    // nowhere else. No other module computes a terminal coordinate.
    पङ्क्तिचित्रम्(ऊर्ध्वम्, पङ्क्तिः) { <~ ऊर्ध्वम् + (८ - पङ्क्तिः) + १ }
    स्तम्भचित्रम्(वामम्, स्तम्भः) { <~ वामम् + ३ + (स्तम्भः - १) * २ }

    फलकोर्ध्वम्(उच्चता) { <~ २ }
    फलकवामम्(विस्तारः, विन्यासः) {
        ? विन्यासः == २ { <~ २ }
        अवशिष्टम् = विस्तारः - २१
        ? अवशिष्टम् <= ० { <~ १ }
        <~ अवशिष्टम् / २ + १
    }

    // ---- फलकस्य चित्रणम् -----------------------------------------
    फलकचित्रणम्(स्थितिः, रूपम्, फलकम्, ऊर्ध्वम्, वामम्, सूचकपदम्, चितपदम्) {
        _स्तम्भलेखाः(ऊर्ध्वम्, वामम्)
        _स्तम्भलेखाः(ऊर्ध्वम् + ९, वामम्)
        @ पङ्क्तिः:१..८ {
            प = पङ्क्तिचित्रम्(ऊर्ध्वम्, पङ्क्तिः)
            >>~ (प, वामम्) > अक्ष::वामपूरणम्("{पङ्क्तिः}", २) " "
            @ स्तम्भः:१..८ {
                कोष्ठचित्रणम्(स्थितिः, रूपम्, फलकम्, ऊर्ध्वम्, वामम्, पङ्क्तिः, स्तम्भः, सूचकपदम्, चितपदम्)
            }
            स्थानम् = स्तम्भचित्रम्(वामम्, ८) + २
            >>~ (प, स्थानम्) > " " "{पङ्क्तिः}"
        }
        <~ ०
    }

    _स्तम्भलेखाः(प, वामम्) {
        पाठः = ""
        @ स्तम्भः:१..८ {
            नाम = रू::स्तम्भनाम(स्तम्भः)
            पाठः = "{पाठः}{नाम} "
        }
        >>~ (प, वामम् + ३) > पाठः
        <~ ०
    }

    // एकः कोष्ठः। सूचकः अत्र चेत् वर्णौ विपर्यस्येते; चितम् अङ्गं
    // चेत् अन्येन पृष्ठेन दर्श्यते।
    //
    // EN: One cell. Under the cursor the colours invert; a selected
    // piece gets a background of its own, so "what I picked up" and
    // "where I am" are two different marks and never one.
    कोष्ठचित्रणम्(स्थितिः, रूपम्, फलकम्, ऊर्ध्वम्, वामम्, पङ्क्तिः, स्तम्भः, सूचकपदम्, चितपदम्) {
        स्थानम् = अ::पदम्(पङ्क्तिः, स्तम्भः)
        अङ्गम् = स्थितिः[स्थानम्]
        पाठः = रू::कोष्ठम्(रूपम्, अङ्गम्, " ")

        पृष्ठम् = रू::कोष्ठपृष्ठम्(फलकम्, रूपम्, अङ्गम्, पङ्क्तिः, स्तम्भः)
        पुरः = रू::अङ्गपुरोवर्णः(अ::अङ्गवर्णः(अङ्गम्))

        ? स्थानम् == चितपदम् { पृष्ठम् = ७० }
        ? स्थानम् == सूचकपदम् {
            पृष्ठम् = २२६
            पुरः = १६
        }

        प = पङ्क्तिचित्रम्(ऊर्ध्वम्, पङ्क्तिः)
        स = स्तम्भचित्रम्(वामम्, स्तम्भः)
        >>~ (प, स, ०, पुरः, पृष्ठम्) > पाठः
        <~ ०
    }

    // ---- पार्श्वखण्डः --------------------------------------------
    // पूरणात् पूर्वं छेदनम्। दक्षिणपूरणम् दीर्घं पाठं यथावत्
    // प्रत्यागमयति — छेदनं तस्य कार्यं न — अतः छेदनं विना एका
    // दीर्घा अनुवादः समग्रं परिवेष्टनं भिन्द्यात्।
    //
    // एतत् मापितम्, न शङ्कितम्: स्पानिश्भाषायाम् "Símbolos de
    // ajedrez" इति त्रयोविंशतिः स्तम्भाः, अवकाशः च अष्टादश।
    //
    // EN: Truncate before padding. दक्षिणपूरणम् returns an overlong
    // string untouched — truncation is not its job — so without
    // this, one long translation breaks the whole frame.
    //
    // Measured, not feared: Spanish "Símbolos de ajedrez" is 23
    // columns and the slot is 18.
    _खण्डरेखा(प, स, वामपाठः, दक्षिणपाठः) {
        अन्तर्विस्तारः = २४
        वामावकाशः = ११
        दक्षिणावकाशः = अन्तर्विस्तारः - वामावकाशः - १
        वाम = अक्ष::दक्षिणपूरणम्(अक्ष::छेदनम्(वामपाठः, वामावकाशः), वामावकाशः)
        दक्षिण = अक्ष::दक्षिणपूरणम्(अक्ष::छेदनम्(दक्षिणपाठः, दक्षिणावकाशः), दक्षिणावकाशः)
        >>~ (प, स) > "│ " वाम दक्षिण "│"
        <~ ०
    }

    _खण्डपट्टी(प, स, चिह्नम्) {
        रेखा = ""
        @ _क:१..२४ { रेखा = "{रेखा}─" }
        ?? चिह्नम् {
            १ => { >>~ (प, स) > "╭" रेखा "╮" }
            ३ => { >>~ (प, स) > "╰" रेखा "╯" }
            _ => { >>~ (प, स) > "├" रेखा "┤" }
        }
        <~ ०
    }

    // खण्डः। सर्वे लेखाः सूत्रेभ्यः, सर्वे अङ्काः वर्तमानायाः
    // अङ्कलिप्याः।
    //
    // EN: The panel. Every label comes from a key and every number
    // from the active numeral script, so the same code draws it in
    // five languages and three digit sets.
    खण्डचित्रणम्(अवस्था, सज्जा, प, स) {
        हस्तः = अवस्था[१]
        चालसंख्या = अवस्था[२]
        श्वेतगृहीतम् = अवस्था[३]
        कृष्णगृहीतम् = अवस्था[४]
        अन्तिमः = अवस्था[५]
        सामग्री = अवस्था[६]

        _खण्डपट्टी(प, स, १)
        _खण्डरेखा(प + १, स, भा::शब्दः("खण्ड.हस्तः"), _वर्णनाम(हस्तः))
        _खण्डरेखा(प + २, स, भा::शब्दः("खण्ड.चालसंख्या"), "{चालसंख्या}")
        _खण्डरेखा(प + ३, स, भा::शब्दः("खण्ड.गृहीतानि"), "{श्वेतगृहीतम्} · {कृष्णगृहीतम्}")
        _खण्डपट्टी(प + ४, स, २)
        _खण्डरेखा(प + ५, स, भा::शब्दः("खण्ड.स्तरः"), भा::शब्दः(_स्तरसूत्रम्(सज्जा[१])))
        _खण्डरेखा(प + ६, स, भा::शब्दः("खण्ड.अन्तिमः"), चालनाम(अन्तिमः))
        _खण्डरेखा(प + ७, स, भा::शब्दः("खण्ड.सामग्री"), _सामग्रीपाठः(सामग्री))
        _खण्डपट्टी(प + ८, स, ३)
        <~ ०
    }

    // सङ्कीर्णे पटले खण्डः एकस्यां घनायां पङ्क्तौ सङ्कोच्यते।
    // दीर्घे सङ्कीर्णे च पटले दशपङ्क्तिकं परिवृतं खण्डं धारयितुं
    // स्थानं नास्ति।
    //
    // EN: On a narrow terminal the panel collapses to one dense
    // line — a tall narrow window cannot afford ten rows of frame.
    अधःखण्डः(अवस्था, सज्जा, प, स) {
        हस्तः = _वर्णनाम(अवस्था[१])
        चालसंख्या = अवस्था[२]
        श्वेतगृहीतम् = अवस्था[३]
        कृष्णगृहीतम् = अवस्था[४]
        अन्तिमः = चालनाम(अवस्था[५])
        >>~ (प, स) > " " हस्तः "  " "{चालसंख्या}" "  " "{श्वेतगृहीतम्} · {कृष्णगृहीतम्}" "  " अन्तिमः
        <~ ०
    }

    _वर्णनाम(वर्णः) {
        ? वर्णः == १ { <~ भा::शब्दः("वर्ण.श्वेतः") }
        <~ भा::शब्दः("वर्ण.कृष्णः")
    }

    _स्तरसूत्रम्(स्तरः) {
        <~ ?? स्तरः {
            १ => "स्तर.१"
            २ => "स्तर.२"
            _ => "स्तर.३"
        }
    }

    // सामग्र्याः भेदः चिह्नेन सह। शून्यं चेत् "—", यतः "+०" इति
    // समतां वक्तुं कुत्सितः उपायः।
    //
    // EN: The material difference with its sign. Zero prints as an
    // em dash, because "+0" is an ugly way to say level.
    _सामग्रीपाठः(भेदः) {
        ? भेदः == ० { <~ "—" }
        ? भेदः > ० {
            श्वेतः = भा::शब्दः("वर्ण.श्वेतः")
            <~ "{श्वेतः} +{भेदः}"
        }
        कृष्णः = भा::शब्दः("वर्ण.कृष्णः")
        धनम् = ० - भेदः
        <~ "{कृष्णः} +{धनम्}"
    }

    // ---- वार्ता --------------------------------------------------
    वार्ताचित्रणम्(पाठः, प, स, विस्तारः) {
        रिक्तम् = अक्ष::दक्षिणपूरणम्("", विस्तारः - २)
        >>~ (प, स) > रिक्तम्
        ? पाठः <> "" {
            >>~ (प, स) > " " अक्ष::छेदनम्(पाठः, विस्तारः - ३)
        }
        <~ ०
    }

    // ---- सज्जायाः पटलम् ------------------------------------------
    // अन्तर्विस्तारः बहिः गण्यते और अत्र आगच्छति। कारणम्: सज्जायाः
    // पटलं फलकात् अधिकं विस्तारं याचते, और यत् पटलं सङ्कीर्णं तत्र
    // अपि सज्जा दृश्या भवितव्या। स्थिरः विस्तारः अष्टचत्वारिंशत्-
    // स्तम्भके पटले परिवेषात् बहिः गच्छेत्।
    //
    // EN: The interior width is computed outside and handed in. The
    // setup screen wants more columns than the board does, and it
    // still has to be readable on a terminal that only just fits the
    // board — a fixed width would run off the edge of a narrow one.
    सज्जाचित्रणम्(सज्जा, चितपङ्क्तिः, भाषासंकेतः, प, स, अन्तर्विस्तारः) {
        शीर्षकम् = भा::शब्दः("सूची.शीर्षकम्")
        नामावकाशः = १४
        ? अन्तर्विस्तारः < ३० { नामावकाशः = ९ }
        मूल्यावकाशः = अन्तर्विस्तारः - नामावकाशः - ४

        _पटलपट्टी(प, स, अन्तर्विस्तारः, १)
        >>~ (प + १, स) > "│" अक्ष::मध्यस्थम्(अक्ष::छेदनम्(शीर्षकम्, अन्तर्विस्तारः), अन्तर्विस्तारः) "│"
        >>~ (प + २, स) > "│" अक्ष::मध्यस्थम्(अक्ष::छेदनम्("अष्टापदम् · ८ × ८", अन्तर्विस्तारः), अन्तर्विस्तारः) "│"
        _पटलपट्टी(प + ३, स, अन्तर्विस्तारः, २)

        सूत्राणि = ["सूची.स्तरः", "सूची.पक्षः", "सूची.रूपम्", "सूची.फलकम्", "सूची.भाषा"]
        मूल्यानि = [
            भा::शब्दः(_स्तरसूत्रम्(सज्जा[१])),
            _पक्षपाठः(सज्जा[४]),
            भा::शब्दः(रू::रूपसूत्रम्(सज्जा[२])),
            भा::शब्दः(रू::फलकसूत्रम्(सज्जा[३])),
            भा::शब्दः("भाषा.नाम")
        ]

        @ क:१..५ {
            सूचकः = "  "
            ? क == चितपङ्क्तिः { सूचकः = "► " }
            नाम = अक्ष::दक्षिणपूरणम्(अक्ष::छेदनम्(भा::शब्दः(सूत्राणि[क]), नामावकाशः), नामावकाशः)
            मूल्यम् = अक्ष::छेदनम्("‹ " $++ मूल्यानि[क] $++ " ›", मूल्यावकाशः)
            >>~ (प + ३ + क, स) > "│ " सूचकः नाम अक्ष::मध्यस्थम्(मूल्यम्, मूल्यावकाशः) " │"
        }

        _पटलपट्टी(प + ९, स, अन्तर्विस्तारः, २)
        निर्देशः = अक्ष::छेदनम्(भा::शब्दः("सूची.निर्देशः"), अन्तर्विस्तारः)
        >>~ (प + १०, स) > "│" अक्ष::मध्यस्थम्(निर्देशः, अन्तर्विस्तारः) "│"
        _पटलपट्टी(प + ११, स, अन्तर्विस्तारः, ३)
        <~ ०
    }

    _पक्षपाठः(मनुष्यवर्णः) {
        वर्णः = _वर्णनाम(मनुष्यवर्णः)
        त्वम् = भा::शब्दः("पक्ष.मनुष्यः")
        <~ "{वर्णः} ({त्वम्})"
    }

    _पटलपट्टी(प, स, विस्तारः, चिह्नम्) {
        रेखा = ""
        @ _क:१..विस्तारः { रेखा = "{रेखा}─" }
        ?? चिह्नम् {
            १ => { >>~ (प, स) > "╭" रेखा "╮" }
            ३ => { >>~ (प, स) > "╰" रेखा "╯" }
            _ => { >>~ (प, स) > "├" रेखा "┤" }
        }
        <~ ०
    }

    // ---- अन्तस्य पटलम् -------------------------------------------
    अन्तचित्रणम्(जेता, कारणम्, अवस्था, प, स, अन्तर्विस्तारः) {
        _पटलपट्टी(प, स, अन्तर्विस्तारः, १)
        _मध्यरेखा(प + १, स, भा::शब्दः("अन्तः.शीर्षकम्"), अन्तर्विस्तारः)
        _पटलपट्टी(प + २, स, अन्तर्विस्तारः, २)
        _मध्यरेखा(प + ३, स, भा::शब्दः(_कारणसूत्रम्(कारणम्)), अन्तर्विस्तारः)
        _मध्यरेखा(प + ४, स, भा::जयवाक्यम्(जेता, कारणम्), अन्तर्विस्तारः)
        _पटलपट्टी(प + ५, स, अन्तर्विस्तारः, २)
        चालसंख्या = अवस्था[२]
        चालपाठः = भा::शब्दः("खण्ड.चालसंख्या")
        _मध्यरेखा(प + ६, स, "{चालपाठः}: {चालसंख्या}", अन्तर्विस्तारः)
        _पटलपट्टी(प + ७, स, अन्तर्विस्तारः, ३)
        <~ ०
    }

    _मध्यरेखा(प, स, पाठः, अन्तर्विस्तारः) {
        >>~ (प, स) > "│" अक्ष::मध्यस्थम्(अक्ष::छेदनम्(पाठः, अन्तर्विस्तारः), अन्तर्विस्तारः) "│"
        <~ ०
    }

    _कारणसूत्रम्(कारणम्) {
        <~ ?? कारणम् {
            १ => "अन्तः.मातः"
            २ => "अन्तः.गतिरोधः"
            ३ => "अन्तः.निर्वस्त्रः"
            ४ => "अन्तः.समता"
            ५ => "वार्ता.त्यागः"
            ६ => "अन्तः.पुनरावृत्तिः"
            _ => "अन्तः.शीर्षकम्"
        }
    }

    // ---- साहाय्यम् -----------------------------------------------
    साहाय्यचित्रणम्(प, स, अन्तर्विस्तारः) {
        कुञ्चिकाः = ["↑↓←→", "↵", "u", "t", "?", "q"]
        सूत्राणि = [
            "सञ्चालन.गतिः", "सञ्चालन.चयनम्", "सञ्चालन.प्रत्यावृत्तिः",
            "सञ्चालन.रूपान्तरम्", "सञ्चालन.साहाय्यम्", "सञ्चालन.त्यागः"
        ]
        कुञ्चिकावकाशः = ८
        अर्थावकाशः = अन्तर्विस्तारः - कुञ्चिकावकाशः - २

        _पटलपट्टी(प, स, अन्तर्विस्तारः, १)
        _मध्यरेखा(प + १, स, भा::शब्दः("सञ्चालन.शीर्षकम्"), अन्तर्विस्तारः)
        _पटलपट्टी(प + २, स, अन्तर्विस्तारः, २)
        @ क:१..६ {
            कुञ्चिका = अक्ष::दक्षिणपूरणम्(कुञ्चिकाः[क], कुञ्चिकावकाशः)
            अर्थपाठः = अक्ष::छेदनम्(भा::शब्दः(सूत्राणि[क]), अर्थावकाशः)
            अर्थः = अक्ष::दक्षिणपूरणम्(अर्थपाठः, अर्थावकाशः)
            >>~ (प + २ + क, स) > "│ " कुञ्चिका अर्थः " │"
        }
        _पटलपट्टी(प + ९, स, अन्तर्विस्तारः, ३)
        <~ ०
    }
}
