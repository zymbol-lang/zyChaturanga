// ============================================================
// क्रीडा.zy — क्रीडायाः सञ्चालनम्
//
// सज्जायाः पटलम्, हस्तानां चक्रम्, क्रीडायाः अन्तः — एतत् अस्य
// कार्यम्। किं भवति इति अत्र निर्णीयते; कथं दृश्यते इति
// दर्शनम्/चित्रणम्.zy, किं वैधम् इति मूल/। एकमपि वाक्यं यत् क्रीडकः
// पठति, तत् अत्र न रच्यते — सर्वं सूत्रेण भाषा/ इत्यस्मात्।
//
// संग्रहाणां रचना (सा एव दर्शनम्/चित्रणम्.zy इत्यत्रापि):
//   सज्जा[१] स्तरः  [२] रूपम्  [३] फलकम्  [४] मनुष्यवर्णः
//   अवस्था[१] हस्तः [२] चालसंख्या [३] श्वेतगृहीतम् [४] कृष्णगृहीतम्
//         [५] अन्तिमचालः [६] सामग्रीभेदः
//
// इतिहासः त्रिषु समान्तरेषु संग्रहेषु: चालः, गृहीतम् अङ्गम्, गतम्
// अङ्गम्। तृतीयः आवश्यकः यतः पत्तिः मन्त्री भवितुम् अर्हति, और
// प्रत्यावर्तने पत्तिः एव प्रत्यागन्तव्यः, न मन्त्री।
//
// दिशाकुञ्चिकाः <<| इत्यस्मात् चिह्नानि एव आगच्छन्ति — '↑' '↓'
// '←' '→' — न तु 'U' 'D' 'L' 'R'। GUIDE.md §3b अन्यथा वदति और
// तत् मिथ्या; serpiente v0.0.5 तः चिह्नैः एव मेलयति।
//
// EN: क्रीडा.zy — the match controller
//
// The setup screen, the turn loop and the end of the game. It
// decides *what* happens; दर्शनम्/चित्रणम्.zy decides how it looks
// and मूल/ decides what is legal. Not one sentence a player reads
// is built here — they all arrive through a key from भाषा/.
//
// Array layouts (the same table appears in दर्शनम्/चित्रणम्.zy):
//   सज्जा[1] level [2] piece set [3] board style [4] human's colour
//   अवस्था[1] side to move [2] move number [3] white's captures
//         [4] black's captures [5] last move [6] material difference
//
// History is three parallel arrays: the move, the piece it took,
// and the piece that moved. The third is needed because a foot
// soldier can promote, and taking the move back has to put a foot
// soldier down again, not a counsellor.
//
// Arrow keys arrive from <<| as the glyphs themselves — '↑' '↓'
// '←' '→' — not as 'U' 'D' 'L' 'R'. GUIDE.md §3b says otherwise and
// is wrong; serpiente has matched on the glyphs since v0.0.5.
// ============================================================

# क्रीडा {

    <# ./मूल/अष्टापदम् => अ
    <# ./मूल/चालाः => च
    <# ./मूल/नियमाः => नि
    <# ./मूल/आकलनम् => आक
    <# ./मूल/मतिः => मति
    <# ./दर्शनम्/चित्रणम् => चि
    <# ./दर्शनम्/रूपम् => रू
    <# ./दर्शनम्/अक्षरम् => अक्ष
    <# ./भाषा/प्रेषकः => भा

    #> { आरम्भः }

    आरम्भः(भाषासंकेतः) {
        भा::निर्धारणम्(भाषासंकेतः)
        [उच्चता, विस्तारः] = >>?

        // पृथक्पटलं प्रविश्य पूर्वम् एव निषेधः। यत् पटलं चित्रयितुं
        // सङ्कीर्णं, तत् क्षमां याचितुम् अपि सङ्कीर्णम्।
        //
        // EN: Refuse before entering the alternate screen: a
        // terminal too small to draw on is also too small to
        // apologise on.
        ? रू::विन्यासः(विस्तारः, उच्चता) == ० {
            _सङ्कीर्णम्(उच्चता, विस्तारः)
            <~ १
        }

        >>| {
            सज्जा = _सज्जापटलम्(उच्चता, विस्तारः)
            ? (सज्जा$#) > ० {
                _क्रीडनम्(सज्जा, उच्चता, विस्तारः)
            }
        }
        <~ ०
    }

    _सङ्कीर्णम्(उच्चता, विस्तारः) {
        >> भा::शब्दः("पटल.संकीर्णम्") ¶
        अपेक्षितविस्तारः = रू::न्यूनविस्तारः()
        अपेक्षिता = रू::न्यूनोच्चता_अधः()
        >> "  " विस्तारः " × " उच्चता "  →  " अपेक्षितविस्तारः " × " अपेक्षिता ¶
    }

    // परिवृतानां पटलानाम् अन्तर्विस्तारः। षट्चत्वारिंशत् यावत्
    // इष्टम्, किन्तु पटलात् चतुर्भिः स्तम्भैः न्यूनम् — यथा
    // सङ्कीर्णे पटले अपि परिवेषः अन्तर्गतः तिष्ठति।
    //
    // EN: The interior width of the framed screens. Forty-six when
    // there is room, and always at least four columns narrower than
    // the terminal, so the frame stays inside it on a narrow one.
    _पटलान्तर्विस्तारः(विस्तारः) {
        उपलब्धम् = विस्तारः - ४
        ? उपलब्धम् < १८ { <~ १८ }
        ? उपलब्धम् > ४६ { <~ ४६ }
        <~ उपलब्धम्
    }

    // ---- सज्जा ---------------------------------------------------
    _चक्रम्(मूल्यम्, कुलम्, दिश्) {
        नवम् = मूल्यम् + दिश्
        ? नवम् < १ { <~ कुलम् }
        ? नवम् > कुलम् { <~ १ }
        <~ नवम्
    }

    _स्थानम्(सूची, मूल्यम्) {
        कुलम् = सूची$#
        @ क:१..कुलम् {
            ? सूची[क] == मूल्यम् { <~ क }
        }
        <~ १
    }

    // सज्जायाः संग्रहं ददाति; क्रीडकः त्यजति चेत् [] ददाति।
    // EN: Returns the settings array, or [] when the player quits.
    _सज्जापटलम्(उच्चता, विस्तारः) {
        रूपसूची = रू::रूपसूची()
        फलकसूची = रू::फलकसूची()
        भाषासूची = भा::भाषासूची()

        स्तराङ्कः = २
        रूपाङ्कः = १
        फलकाङ्कः = १
        मनुष्यवर्णः = १
        भाषाङ्कः = _स्थानम्(भाषासूची, भा::वर्तमाना())
        चिता = १

        अन्तर्विस्तारः = _पटलान्तर्विस्तारः(विस्तारः)
        प = (उच्चता - १२) / २ + १
        ? प < १ { प = १ }
        स = (विस्तारः - अन्तर्विस्तारः - २) / २ + १
        ? स < १ { स = १ }

        >>!
        @ {
            सज्जा = [स्तराङ्कः, रूपसूची[रूपाङ्कः], फलकसूची[फलकाङ्कः], मनुष्यवर्णः]
            चि::सज्जाचित्रणम्(सज्जा, चिता, भाषासूची[भाषाङ्कः], प, स, अन्तर्विस्तारः)

            <<| कुञ्चिका
            ?? कुञ्चिका {
                '↑' => { चिता = _चक्रम्(चिता, ५, ० - १) }
                '↓' => { चिता = _चक्रम्(चिता, ५, १) }
                '←' => {
                    ?? चिता {
                        १ => { स्तराङ्कः = _चक्रम्(स्तराङ्कः, ३, ० - १) }
                        २ => { मनुष्यवर्णः = _चक्रम्(मनुष्यवर्णः, २, ० - १) }
                        ३ => { रूपाङ्कः = _चक्रम्(रूपाङ्कः, रूपसूची$#, ० - १) }
                        ४ => { फलकाङ्कः = _चक्रम्(फलकाङ्कः, फलकसूची$#, ० - १) }
                        _ => {
                            भाषाङ्कः = _चक्रम्(भाषाङ्कः, भाषासूची$#, ० - १)
                            भा::निर्धारणम्(भाषासूची[भाषाङ्कः])
                            >>!
                        }
                    }
                }
                '→' => {
                    ?? चिता {
                        १ => { स्तराङ्कः = _चक्रम्(स्तराङ्कः, ३, १) }
                        २ => { मनुष्यवर्णः = _चक्रम्(मनुष्यवर्णः, २, १) }
                        ३ => { रूपाङ्कः = _चक्रम्(रूपाङ्कः, रूपसूची$#, १) }
                        ४ => { फलकाङ्कः = _चक्रम्(फलकाङ्कः, फलकसूची$#, १) }
                        _ => {
                            भाषाङ्कः = _चक्रम्(भाषाङ्कः, भाषासूची$#, १)
                            भा::निर्धारणम्(भाषासूची[भाषाङ्कः])
                            >>!
                        }
                    }
                }
                '\n' => { <~ [स्तराङ्कः, रूपसूची[रूपाङ्कः], फलकसूची[फलकाङ्कः], मनुष्यवर्णः] }
                '\r' => { <~ [स्तराङ्कः, रूपसूची[रूपाङ्कः], फलकसूची[फलकाङ्कः], मनुष्यवर्णः] }
                'q'  => { <~ [] }
                'Q'  => { <~ [] }
                _    => { }
            }
        }
        <~ []
    }

    // ---- क्रीडा --------------------------------------------------
    _क्रीडनम्(सज्जा, उच्चता, विस्तारः) {
        स्थितिः = अ::नवम्()
        अ::सेनास्थापनम्(स्थितिः<~)

        अवस्था = [१, ०, ०, ०, ०, ०]
        इतिचालाः = []
        इतिगृहीतानि = []
        इतिअङ्गानि = []

        मनुष्यवर्णः = सज्जा[४]
        विन्यासः = रू::विन्यासः(विस्तारः, उच्चता)
        ऊर्ध्वम् = चि::फलकोर्ध्वम्(उच्चता)
        वामम् = चि::फलकवामम्(विस्तारः, विन्यासः)

        खण्डप = ऊर्ध्वम्
        खण्डस = वामम् + २३
        ? विन्यासः == १ {
            खण्डप = ऊर्ध्वम् + ११
            खण्डस = वामम्
        }
        वार्ताप = ऊर्ध्वम् + १२
        ? विन्यासः == २ { वार्ताप = ऊर्ध्वम् + ११ }

        सूचकपदम् = अ::पदम्(१, ५)
        ? मनुष्यवर्णः == २ { सूचकपदम् = अ::पदम्(८, ५) }
        चितपदम् = ०
        वार्ता = ""

        >>!
        @ {
            अवस्था[६] = आक::सामग्री(स्थितिः, १) - आक::सामग्री(स्थितिः, २)
            चि::फलकचित्रणम्(स्थितिः, सज्जा[२], सज्जा[३], ऊर्ध्वम्, वामम्, सूचकपदम्, चितपदम्)
            ? विन्यासः == २ {
                चि::खण्डचित्रणम्(अवस्था, सज्जा, खण्डप, खण्डस)
            } _ {
                चि::अधःखण्डः(अवस्था, सज्जा, खण्डप, खण्डस)
            }
            चि::वार्ताचित्रणम्(वार्ता, वार्ताप, वामम्, विस्तारः - वामम्)

            // क्रीडायाः अन्तः प्रत्येकं हस्ते पृच्छ्यते, न चालात्
            // अनन्तरम् एव। मातः प्रतिपक्षस्य हस्ते ज्ञायते, न
            // तत्कर्तुः।
            //
            // EN: The end of the game is asked at the start of each
            // turn, not after each move. A mate is a fact about the
            // side that has to move, not about the side that
            // delivered it.
            परिणामः = नि::परिणामः(स्थितिः<~, अवस्था[१])
            ? परिणामः > ० {
                जेता = अ::रिपुः(अवस्था[१])
                ? परिणामः == ४ { जेता = ० }
                _अन्तपटलम्(जेता, परिणामः, अवस्था, उच्चता, विस्तारः)
                @!
            }

            ? अवस्था[१] == मनुष्यवर्णः {
                // मनुष्यस्य हस्तः
                <<| कुञ्चिका
                ?? कुञ्चिका {
                    '↑' => { सूचकपदम् = _सूचकगतिः(सूचकपदम्, १, ०) }
                    '↓' => { सूचकपदम् = _सूचकगतिः(सूचकपदम्, ० - १, ०) }
                    '←' => { सूचकपदम् = _सूचकगतिः(सूचकपदम्, ०, ० - १) }
                    '→' => { सूचकपदम् = _सूचकगतिः(सूचकपदम्, ०, १) }
                    't' => {
                        सज्जा[२] = _अग्रिमरूपम्(सज्जा[२])
                        >>!
                    }
                    'u' => {
                        फलम् = _प्रत्यावर्तनम्(स्थितिः<~, अवस्था<~, इतिचालाः<~, इतिगृहीतानि<~, इतिअङ्गानि<~, मनुष्यवर्णः)
                        वार्ता = भा::शब्दः(फलम्)
                        चितपदम् = ०
                    }
                    '?' => {
                        _साहाय्यपटलम्(उच्चता, विस्तारः)
                        >>!
                    }
                    'q' => {
                        _अन्तपटलम्(अ::रिपुः(मनुष्यवर्णः), ५, अवस्था, उच्चता, विस्तारः)
                        @!
                    }
                    'Q' => {
                        _अन्तपटलम्(अ::रिपुः(मनुष्यवर्णः), ५, अवस्था, उच्चता, विस्तारः)
                        @!
                    }
                    _ => {
                        ? _चयनकुञ्चिका(कुञ्चिका) {
                            चितपदम् = _चयनम्(स्थितिः<~, अवस्था<~, सूचकपदम्, चितपदम्, इतिचालाः<~, इतिगृहीतानि<~, इतिअङ्गानि<~, वार्ता<~)
                        }
                    }
                }
            } _ {
                // यन्त्रस्य हस्तः
                // EN: the machine's turn
                चि::वार्ताचित्रणम्(भा::शब्दः("वार्ता.चिन्तयति"), वार्ताप, वामम्, विस्तारः - वामम्)
                पदानि = ०
                चालः = मति::चालचयनम्(स्थितिः<~, अवस्था[१], सज्जा[१], पदानि<~)
                ? चालः == ० {
                    वार्ता = ""
                } _ {
                    वार्ता = _चालकरणम्(स्थितिः<~, अवस्था<~, चालः, इतिचालाः<~, इतिगृहीतानि<~, इतिअङ्गानि<~)
                }
            }
        }
        <~ ०
    }

    _सूचकगतिः(पदम्, पदिप, पदिस) {
        पङ्क्तिः = अ::पङ्क्त्यङ्कः(पदम्) + पदिप
        स्तम्भः = अ::स्तम्भाङ्कः(पदम्) + पदिस
        ? पङ्क्तिः < १ { पङ्क्तिः = ८ }
        ? पङ्क्तिः > ८ { पङ्क्तिः = १ }
        ? स्तम्भः < १ { स्तम्भः = ८ }
        ? स्तम्भः > ८ { स्तम्भः = १ }
        <~ अ::पदम्(पङ्क्तिः, स्तम्भः)
    }

    _चयनकुञ्चिका(कुञ्चिका) {
        ? कुञ्चिका == '\n' { <~ #१ }
        ? कुञ्चिका == '\r' { <~ #१ }
        ? कुञ्चिका == ' ' { <~ #१ }
        <~ #०
    }

    _अग्रिमरूपम्(रूपम्) {
        सूची = रू::रूपसूची()
        कुलम् = सूची$#
        अङ्कः = _स्थानम्(सूची, रूपम्) + १
        ? अङ्कः > कुलम् { अङ्कः = १ }
        <~ सूची[अङ्कः]
    }

    // चयनम्: प्रथमः स्पर्शः अङ्गं गृह्णाति, द्वितीयः चालयति।
    // नवं चितपदं प्रत्यागच्छति, वार्ता च निर्गमप्राचलेन याति।
    //
    // द्वयोः मूल्ययोः संग्रहः न शक्यः: Zymbol इति भाषायां संग्रहस्य
    // सर्वाणि तत्त्वानि एकजातीयानि, अत्र च एकम् अङ्कः अन्यत् च
    // पाठः। निर्गमप्राचलः एव अस्याः भाषायाः उत्तरम्।
    //
    // EN: Selection: the first press picks a piece up, the second
    // plays it. Returns the new selection; the message leaves
    // through an output parameter.
    //
    // Not a two-element array: Zymbol arrays are homogeneous and
    // these are an Int and a String. The output parameter is the
    // language's own answer to returning two things.
    _चयनम्(स्थितिः<~, अवस्था<~, सूचकपदम्, चितपदम्, इतिचालाः<~, इतिगृहीतानि<~, इतिअङ्गानि<~, वार्ता<~) {
        अङ्गम् = स्थितिः[सूचकपदम्]
        हस्तः = अवस्था[१]
        वार्ता = ""

        ? चितपदम् == ० {
            ? अङ्गम् == ० {
                वार्ता = भा::शब्दः("वार्ता.रिक्तम्")
                <~ ०
            }
            ? अ::अङ्गवर्णः(अङ्गम्) <> हस्तः {
                वार्ता = भा::शब्दः("वार्ता.परकीयम्")
                <~ ०
            }
            <~ सूचकपदम्
        }

        ? सूचकपदम् == चितपदम् { <~ ० }

        // स्वस्य अन्यम् अङ्गं चेत्, चयनं तत्र गच्छति। एतत्
        // सुखदम्: क्रीडकः अन्यत् अङ्गं स्पृष्ट्वा पूर्वं निरसनं
        // कर्तुं न बाध्यते।
        //
        // EN: Touching another of one's own pieces moves the
        // selection there rather than failing — the player never has
        // to cancel first.
        ? अङ्गम् <> ० {
            ? अ::अङ्गवर्णः(अङ्गम्) == हस्तः { <~ सूचकपदम् }
        }

        चालः = अ::चालरचना(चितपदम्, सूचकपदम्)
        ? _वैधचालः(स्थितिः<~, चालः, हस्तः) {
            वार्ता = _चालकरणम्(स्थितिः<~, अवस्था<~, चालः, इतिचालाः<~, इतिगृहीतानि<~, इतिअङ्गानि<~)
            <~ ०
        }

        // अवैधः चालः द्विधा भवति: अङ्गस्य गतिनियमेन, स्वराज्ञः
        // संकटेन वा। द्वयोः भेदः क्रीडकाय उपयोगी — प्रथमं नियमस्य
        // अज्ञानम्, द्वितीयं दृष्टेः।
        //
        // EN: An illegal move fails for two different reasons — the
        // piece cannot go there, or going there exposes the king.
        // The player learns something different from each, so they
        // are two different messages.
        ? _गतिशीलः(स्थितिः, चालः) {
            वार्ता = भा::शब्दः("वार्ता.स्वसंकटे")
            <~ चितपदम्
        }
        वार्ता = भा::शब्दः("वार्ता.अवैधः")
        <~ चितपदम्
    }

    _गतिशीलः(स्थितिः, चालः) {
        @ अन्यः : च::अङ्गचालाः(स्थितिः, अ::आदिपदम्(चालः)) {
            ? अन्यः == चालः { <~ #१ }
        }
        <~ #०
    }

    _वैधचालः(स्थितिः<~, चालः, वर्णः) {
        ? _गतिशीलः(स्थितिः, चालः) {
            <~ नि::वैधः(स्थितिः<~, चालः, वर्णः)
        }
        <~ #०
    }

    // चालं करोति, अवस्थां नवीकरोति, इतिहासे लिखति, वार्तां ददाति।
    // EN: Plays the move, updates the state, records history, and
    // returns the message.
    _चालकरणम्(स्थितिः<~, अवस्था<~, चालः, इतिचालाः<~, इतिगृहीतानि<~, इतिअङ्गानि<~) {
        हस्तः = अवस्था[१]
        अङ्गम् = स्थितिः[अ::आदिपदम्(चालः)]
        प्रकारः = अ::अङ्गप्रकारः(अङ्गम्)
        अन्तपङ्क्तिः = अ::पङ्क्त्यङ्कः(अ::अन्तपदम्(चालः))

        गृहीतम् = ०
        नि::कृति(स्थितिः<~, चालः, गृहीतम्<~)

        इतिचालाः = इतिचालाः $+ चालः
        इतिगृहीतानि = इतिगृहीतानि $+ गृहीतम्
        इतिअङ्गानि = इतिअङ्गानि $+ अङ्गम्

        ? गृहीतम् <> ० {
            ? हस्तः == १ {
                अवस्था[३] = अवस्था[३] + १
            } _ {
                अवस्था[४] = अवस्था[४] + १
            }
        }

        अवस्था[१] = अ::रिपुः(हस्तः)
        अवस्था[२] = अवस्था[२] + १
        अवस्था[५] = चालः

        // वार्तायाः क्रमः: प्रवर्धनम्, ग्रहणम्, संकटः। एकः एव
        // दृश्यते, अतः दुर्लभतमः प्रथमम्।
        //
        // EN: Message precedence: promotion, capture, check. Only
        // one line is shown, so the rarest event wins.
        ? प्रकारः == १ {
            ? हस्तः == १ {
                ? अन्तपङ्क्तिः == ८ { <~ भा::शब्दः("वार्ता.प्रवर्धनम्") }
            } _ {
                ? अन्तपङ्क्तिः == १ { <~ भा::शब्दः("वार्ता.प्रवर्धनम्") }
            }
        }
        ? गृहीतम् <> ० { <~ भा::ग्रहणवाक्यम्(अ::अङ्गप्रकारः(गृहीतम्)) }
        ? नि::संकटे(स्थितिः, अवस्था[१]) { <~ भा::शब्दः("वार्ता.संकटे") }
        <~ ""
    }

    // प्रत्यावर्तनम्: द्वौ चालौ — यन्त्रस्य उत्तरं और स्वस्य चालः।
    // एकम् एव प्रत्यावर्त्य क्रीडकः यन्त्रस्य हस्ते तिष्ठेत्, तत्
    // च प्रत्यावर्तनं न, दण्डः।
    //
    // EN: Taking back removes two moves — the machine's reply and
    // one's own move. Taking back one would leave the player facing
    // the machine's turn, which is not an undo but a penalty.
    _प्रत्यावर्तनम्(स्थितिः<~, अवस्था<~, इतिचालाः<~, इतिगृहीतानि<~, इतिअङ्गानि<~, मनुष्यवर्णः) {
        संख्या = इतिचालाः$#
        ? संख्या == ० { <~ "वार्ता.प्रत्यावृत्तिनास्ति" }

        कति = २
        ? संख्या < २ { कति = १ }

        @ _क:१..कति {
            अन्तिमः = इतिचालाः$#
            ? अन्तिमः > ० {
                चालः = इतिचालाः[अन्तिमः]
                गृहीतम् = इतिगृहीतानि[अन्तिमः]
                अङ्गम् = इतिअङ्गानि[अन्तिमः]
                नि::प्रत्यावर्तनम्(स्थितिः<~, चालः, अङ्गम्, गृहीतम्)

                ? गृहीतम् <> ० {
                    वर्णः = अ::अङ्गवर्णः(अङ्गम्)
                    ? वर्णः == १ {
                        अवस्था[३] = अवस्था[३] - १
                    } _ {
                        अवस्था[४] = अवस्था[४] - १
                    }
                }
                अवस्था[२] = अवस्था[२] - १
                इतिचालाः = _अन्त्यहीनः(इतिचालाः)
                इतिगृहीतानि = _अन्त्यहीनः(इतिगृहीतानि)
                इतिअङ्गानि = _अन्त्यहीनः(इतिअङ्गानि)
            }
        }

        अवस्था[१] = मनुष्यवर्णः
        शेषः = इतिचालाः$#
        ? शेषः == ० {
            अवस्था[५] = ०
        } _ {
            अवस्था[५] = इतिचालाः[शेषः]
        }
        <~ "वार्ता.प्रत्यावृत्तिः"
    }

    _अन्त्यहीनः(संग्रहः) {
        संख्या = संग्रहः$#
        ? संख्या <= १ { <~ [] }
        फलम् = []
        अन्तिमः = संख्या - १
        @ क:१..अन्तिमः { फलम् = फलम् $+ संग्रहः[क] }
        <~ फलम्
    }

    // ---- पटलानि -------------------------------------------------
    _अन्तपटलम्(जेता, कारणम्, अवस्था, उच्चता, विस्तारः) {
        अन्तर्विस्तारः = _पटलान्तर्विस्तारः(विस्तारः)
        प = (उच्चता - ८) / २ + १
        ? प < १ { प = १ }
        स = (विस्तारः - अन्तर्विस्तारः - २) / २ + १
        ? स < १ { स = १ }
        >>!
        चि::अन्तचित्रणम्(जेता, कारणम्, अवस्था, प, स, अन्तर्विस्तारः)
        <<| _कुञ्चिका
        <~ ०
    }

    _साहाय्यपटलम्(उच्चता, विस्तारः) {
        अन्तर्विस्तारः = _पटलान्तर्विस्तारः(विस्तारः)
        प = (उच्चता - १०) / २ + १
        ? प < १ { प = १ }
        स = (विस्तारः - अन्तर्विस्तारः - २) / २ + १
        ? स < १ { स = १ }
        >>!
        चि::साहाय्यचित्रणम्(प, स, अन्तर्विस्तारः)
        <<| _कुञ्चिका
        <~ ०
    }
}
